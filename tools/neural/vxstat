def health_word(r, s):
    bad = []
    if r["skipped"]:
        bad.append("SKIPPED x%d" % r["skipped"])
    if r["diverge"]:
        bad.append("DIVERGING")
    if r["starved"]:
        bad.append("COURSE STARVATION")
    if r["relaxed"]:
        bad.append("bounds relaxed")
    return s.red(", ".join(bad)) if bad else s.green(G["ok"] + " healthy")


def eval_word(r, s):
    if not r["running"]:
        return s.dim("paused - resumes from checkpoint")
    if r["eval_running"]:
        left = ""
        if r["eval_secs"] and r["eval_secs"] > r["eval_elapsed"]:
            remain = r["eval_secs"] - r["eval_elapsed"]
            left = ", ~%s left, done %s" % (dur(remain), clock_after(remain))
        elif r.get("eval_timeout_secs") and r["eval_timeout_secs"] > r["eval_elapsed"]:
            remain = r["eval_timeout_secs"] - r["eval_elapsed"]
            left = ", estimate exceeded, timeout in %s" % dur(remain)
        return s.cyan("EVAL RUNNING %d/%d shards%s" % (r["eval_done"], r["eval_total"], left))
    if r["eval_every"] and r["update"]:
        try:
            target = int(r.get("next_eval_update") or 0)
        except (TypeError, ValueError):
            target = 0
        togo = max(0, target - r["update"]) if target else r["eval_every"] - (r["update"] % r["eval_every"])
        if r["spu"]:
            remain = togo * r["spu"]
            return "next eval in %du (~%s, %s)" % (togo, dur(remain), clock_after(remain))
        return "next eval in %du" % togo
    return "next eval unknown"


def eval_shard_word(r, s):
    """Compact per-shard liveness: episode counters prove motion; status/retries expose recovery."""
    shards = r.get("eval_shards") or []
    if not r.get("eval_running") or not shards:
        return ""
    cells = []
    for shard in shards:
        i = int(shard.get("index", len(cells)))
        status = shard.get("status", "running")
        episodes = int(shard.get("episodes", 0))
        target = max(1, int(shard.get("episode_target", 1)))
        restarts = int(shard.get("restarts", 0))
        stale = float(shard.get("stale_seconds", 0) or 0)
        if status == "complete":
            value = s.green("%d:%s" % (i, G["ok"]))
        elif status in ("frozen", "failed", "timed_out"):
            value = s.red("%d:%s" % (i, status))
        elif status == "restarting" or restarts:
            value = s.yellow("%d:%d/%d↻%d" % (i, episodes, target, restarts))
        elif stale >= 30:
            value = s.yellow("%d:%d/%d idle%ds" % (i, episodes, target, stale))
        else:
            value = s.cyan("%d:%d/%d" % (i, episodes, target))
        cells.append(value)
    return "  ".join(cells)


def spark(vals, s):
    """Eval history as numbers, best in bold. Exact enough to trust, short enough to scan."""
    if not vals:
        return s.dim("none yet")
    best = max(vals)
    return "  ".join(s.bold("%.1f" % v) if v == best else "%.1f" % v for v in vals)


def eval_spark(vals, s, width=28):
    """Locally zoomed so sub-point eval movement remains visible instead of hugging a 0-100% axis."""
    if not vals:
        return s.dim("no evaluations yet"), ""
    vals = vals[-width:]
    lo, hi = min(vals), max(vals)
    span = max(1.0, hi - lo)
    levels = "▁▂▃▄▅▆▇█" if _utf_ok() else ".:-=+*#@"
    chars = []
    for i, value in enumerate(vals):
        glyph = levels[min(len(levels) - 1, int((value - lo) / span * (len(levels) - 1)))]
        if value == hi:
            glyph = s.green(s.bold(glyph))
        elif i == len(vals) - 1:
            glyph = s.cyan(s.bold(glyph))
        elif i and value < vals[i - 1]:
            glyph = s.magenta(glyph)
        else:
            glyph = s.blue(glyph)
        chars.append(glyph)
    return "".join(chars), f"zoom {lo:.1f}-{hi:.1f}% ({span:.1f}pt)"


def ram_cell(snap, s):
    if not snap.get("ram_total"):
        return "-"
    txt = "%.0f/%.0f GB" % (snap["ram_used"], snap["ram_total"])
    if snap["ram_free"] < 2.0:
        return s.red(txt)
    if snap["ram_free"] < 4.0:
        return s.yellow(txt)
    return txt


def machine_line(snap, s, role, hosts=None, agents=None, share=None, evaling=False):
    hosts = snap["hosts"] if hosts is None else hosts
    if agents is None and hosts:
        agents = hosts * snap.get("agents_per_host", 16)
    cpu = snap.get("cpu", 0.0)
    txt = "%3.0f%%" % (cpu * 100)
    # A worker sitting idle during an eval is expected, not a stall. Saying which it is stops a reader
    # concluding the fleet has died every time a score is being measured.
    if cpu < 0.15 and evaling:
        txt = s.dim(txt + " idle (eval)")
    elif cpu < 0.15 and hosts:
        txt = s.yellow(txt + " IDLE")
    elif cpu > 0.85:
        txt = s.green(txt)
    extra = ""
    if agents:
        extra += "  %d agents" % agents
    if share:
        extra += ", %.0f%% of fleet" % share
    age = s.dim("  %.0fs ago" % snap["age"]) if snap.get("age", 0) > 12 else ""
    return "    %-14s %-18s %3d hosts  %-14s %s%s%s" % (
        snap["machine"], s.dim(role), hosts, ram_cell(snap, s), txt, extra, age)


def _match_peer(addr, peers):
    for p in peers:
        if p.get("unreachable"):
            continue
        if addr in (p.get("target", ""), p.get("machine", "")) or p.get("target", "").endswith("@" + addr):
            return p
    return None


def job_block(r, snap, peers, s, claimed):
    gut = (s.cyan if r["running"] else s.red)(G["bar"]) + " "
    out = ["", gut.rstrip()]
    phase = str(r.get("phase", "training" if r["running"] else "stopped")).replace("_", " ").upper()
    state = s.green(G["run"] + " " + phase) if r["running"] else s.yellow(G["run"] + " " + phase)
    out.append(gut + "%s%sstage %d%s%s%sup %s" % (
        s.bold(s.cyan(r["name"])), G["dot"], r["stage"], G["dot"], state, G["dot"], dur(r["up"])))
    why = r.get("stopped_reason")
    if why:
        mark = s.dim("(deliberate)") if why["deliberate"] else s.red("(failure)")
        out.append(gut + " %s %s %s" % (label(s, "why"), why["text"], mark))
    out.append(gut)

    # A locally-scaled trend shows small movement. Gate/baseline are labelled separately rather than
    # forcing a 0-100% chart where every real eval would occupy the same row.
    best = "%.1f" % r["best"] if r["best"] is not None else "-"
    verdict = ""
    if r["best"] is not None and r["gate"]:
        d = r["gate"] - r["best"]
        # Under ~5 points is inside a single eval's own spread; naming that stops overreading a near-miss.
        verdict = (s.green("CLEARS gate %.0f%%" % r["gate"]) if d <= 0 else
                   s.yellow("%.1f under gate %.0f%% (noise is ~5)" % (d, r["gate"])) if d < 5 else
                   "%.1f under gate %.0f%%" % (d, r["gate"]))
    else:
        verdict = s.dim("gate %.0f%%" % r["gate"]) if r["gate"] else ""
    ratio = ""
    if r["baseline"] and r["best"]:
        ratio = s.dim("  %.2fx base" % (r["best"] / r["baseline"]))
    trend_line, zoom = eval_spark(r["last"], s)
    legend = s.green("peak") + "/" + s.cyan("latest") + "/" + s.magenta("dip")
    out.append(gut + " %s %s  %s  %s" % (label(s, "trend"), trend_line, s.dim(zoom), legend))
    speed = (f"  best time {float(r['best_time']):.2f}s" if r.get("best_time") is not None else "")
    out.append(gut + " %s best %s%%  %s%s%s" % (label(s, "eval"), best, verdict, ratio, s.cyan(speed)))

    out.append(gut)
    pct = r["steps"] / r["budget"] if r["budget"] else 0
    eta = ""
    if r["running"] and r["sps"] and r["budget"] > r["steps"]:
        remain = (r["budget"] - r["steps"]) / r["sps"]
        eta = "   ETA %s (%s)" % (dur(remain), clock_after(remain))
    out.append(gut + " %-7s %s %3.0f%%   %.2fM/%.0fM   %s steps/s%s" % (
        label(s, "steps"), bar(pct, 20, s), pct * 100, r["steps"] / 1e6, r["budget"] / 1e6,
        "{:,.0f}".format(r["sps"]), eta))

    out.append(gut + " %-7s update %s   sampled %.1f%%   entropy %.3f   kl %.4f" % (
        label(s, "state"), "{:,}".format(r["update"]), r["sampled"], r["entropy"], r["kl"]))
    state_detail = health_word(r, s)
    if r["running"]:
        state_detail += "   " + eval_word(r, s)
    out.append(gut + " %-7s %s" % ("", state_detail))
    shard_detail = eval_shard_word(r, s)
    if shard_detail:
        out.append(gut + " %-7s %s" % (label(s, "shards"), shard_detail))

    out.append(gut)
    total_hosts = snap["hosts"] + sum(x["count"] for x in r.get("remotes", []))
    role = "trainer" + ("+hosts" if snap["hosts"] else "")
    out.append(gut + " %s %s" % (label(s, "fleet"),
                              fleet_line(snap, s, role, snap["hosts"], total_hosts, r["eval_running"],
                                         r.get("agents_per_host", 16), r.get("phase", "training"))))
    if not r["running"]:
        out.append(gut + " %-7s %s" % ("", eval_word(r, s)))
    for rem in r.get("remotes", []):
        peer = _match_peer(rem["addr"], peers)
        if peer is not None:
            claimed.add(peer["machine"])
            # Background evaluation uses the trainer box; remote environments keep producing PPO rollout.
            # Only the legacy blocking phase leaves them waiting on an evaluation.
            worker_status = ("waiting on eval" if r.get("phase") == "evaluating"
                             else "simulation rollout")
            out.append(gut + " %-7s %s" % ("", fleet_line(peer, s, "worker", rem["count"], total_hosts,
                                                     r["eval_running"], r.get("agents_per_host", 16),
                                                     worker_status)))
        else:
            out.append(gut + " %-7s %-13s %-8s %3d hosts / %4d agents   %s" % (
                "", rem["addr"], s.dim("worker"), rem["count"],
                rem["count"] * r.get("agents_per_host", 16),
                s.yellow("not polled - add --peer")))
    out.append(gut)
    events = r.get("events", [])[-MIN_EVENT_ROWS:]
    for i in range(MIN_EVENT_ROWS):
        if i < len(events):
            event = events[i]
            at = str(event.get("at", ""))
            stamp = at[11:19] if len(at) >= 19 else "--:--:--"
            content = "%s  %s" % (s.magenta(stamp), event.get("message", ""))
        else:
            content = ""
        out.append(gut + " %s %s" % (label(s, "events" if i == 0 else ""), content))
    return out


def fleet_line(snap, s, role, hosts, total_hosts, evaling, agents_per_host=16, status=None):
    cpu = snap.get("cpu", 0.0)
    cpu_txt = "cpu %3.0f%%" % (cpu * 100)
    if cpu < 0.15 and evaling:
        cpu_txt = s.dim(cpu_txt + " (eval)")
    elif cpu < 0.15 and hosts:
        cpu_txt = s.yellow(cpu_txt + " IDLE")
    elif cpu > 0.85:
        cpu_txt = s.green(cpu_txt)
    agents = hosts * agents_per_host
    share = "  %2.0f%% fleet" % (100.0 * hosts / total_hosts) if total_hosts and hosts else ""
    # A trainer box with --hosts 0 reported "0 hosts" while running four eval shards, so the machine
    # actually burning CPU looked idle and the quiet worker looked broken. Shards are work; show them.
    shards = snap.get("eval_shards_running", 0)
    if hosts:
        hosts_txt = "%3d hosts" % hosts
    elif shards:
        hosts_txt = s.cyan("%3d evals" % shards)
    else:
        hosts_txt = s.dim("  - hosts")
    agents_txt = "  %4d agents" % agents if agents else ("  eval shards" if shards else "")
    age = s.dim("  (%.0fs old)" % snap["age"]) if snap.get("age", 0) > 12 else ""
    status = status or snap.get("work", "idle")
    return "%-13s %-8s %s   %-9s %s%s%s  %-20s%s" % (
        snap["machine"], s.dim(role), hosts_txt, ram_cell(snap, s), cpu_txt, agents_txt, share,
        s.cyan(status), age)


def render_jobs(local, peers, s):
    out = []
    local_now = datetime.now().astimezone()
    now = local_now.strftime("%I:%M:%S %p").lstrip("0") + " ET"
    title = " NEURAL BOT LAB "
    width = max(78, min(150, shutil.get_terminal_size((110, 30)).columns))
    pad_len = max(4, width - len(title) - len(now) - 4)
    out.append(s.bold(G["band"] * 2 + title) + s.dim(G["band"] * pad_len + " " + now + " " + G["band"] * 2))

    claimed = set()
    any_job = False
    for snap in [local] + peers:
        for r in snap.get("runs", []):
            any_job = True
            claimed.add(snap["machine"])
            out.extend(job_block(r, snap, peers, s, claimed))

    for snap in [local] + peers:
        if snap["machine"] in claimed:
            continue
        out.append("")
        if snap.get("unreachable"):
            out.append("  " + s.red("%s: unreachable (%s)" % (snap["machine"], snap["unreachable"])))
        else:
            out.append("  " + s.dim("%s: no run of its own" % snap["machine"]))
            out.append(machine_line(snap, s, snap.get("work", "idle")))
    if not any_job:
        out.append("")
        out.append("  " + s.dim("nothing training"))
    return out


def relaunch(run, runs_dir):
    """Relaunch a stopped run from its stage-best, under the next free version name.

    Resumes stage-best rather than the rolling checkpoint on purpose: a diverged run's rolling checkpoint is
    the last one the save guard allowed, but stage-best is the last one that actually SCORED well, and after
    a divergence those are not the same policy.
    """
    import re as _re
    import subprocess

    cmd = run.get("cmd") or ""
    if "train.py" not in cmd:
        return None, "no launch command recorded"

    m = _re.search(r"--name (v)(\d+)", cmd)
    if not m:
        return None, "run name is not vN, refusing to guess the next one"
    nxt = f"v{int(m.group(2)) + 1}"

    best = os.path.join(runs_dir, run["name"], f"stage{run['stage']}-best.pt")
    if not os.path.exists(best):
        return None, f"no {os.path.basename(best)} to resume from"

    new_cmd = _re.sub(r"--name v\d+", f"--name {nxt}", cmd)
    new_cmd = _re.sub(r'--resume (\S+|"[^"]*")', f'--resume "{best}"', new_cmd)
    if "--resume" not in new_cmd:
        new_cmd += f' --resume "{best}"'

    log = os.path.join(runs_dir, f"{nxt}.log")
    try:
        with open(log, "wb") as fh:
            subprocess.Popen(new_cmd, shell=True, stdout=fh, stderr=subprocess.STDOUT,
                             cwd=os.environ.get("VX_REPO", os.getcwd()))
    except Exception as exc:
        return None, f"launch failed: {type(exc).__name__}: {exc}"
    return nxt, f"resumed from {os.path.basename(best)}"


def watchdog(peers_t, every, restart, s):
    """Poll until a run stops, report why, and relaunch when the reason was not a verdict.

    The distinction is the whole point. A stage that passed, or a stage that finished under its gate, stopped
    because the curriculum said so -- relaunching re-runs a decided experiment and would loop forever. A
    traceback, a vanished process, or a divergence stopped without reaching a verdict, and those are worth
    resuming from the last policy that scored well.
    """
    poller = Peers(peers_t)
    seen_running = set()
    last_size = None
    while True:
        local = snapshot()
        discovered = peer_targets(local, peers_t)
        if discovered != poller.targets:
            # Watchdogs normally start after a run; recreate only when a newly launched run declares a worker.
            poller = Peers(discovered)
        remote = poller.snapshots()
        frame, last_size = live_frame(render_jobs(local, remote, s), last_size)
        sys.stdout.write(frame)

        for snap in [local] + remote:
            for r in snap.get("runs", []):
                if r["running"]:
                    seen_running.add(r["name"])
                    continue
                why = r.get("stopped_reason") or {}
                # Only act on a run this watchdog actually watched running. Otherwise every old log in the
                # runs directory looks like something that just died.
                if r["name"] not in seen_running:
                    continue
                seen_running.discard(r["name"])
                stamp = datetime.now().strftime("%H:%M:%S")
                print(s.red(f"\n  [{stamp}] {r['name']} STOPPED: {why.get('text', 'unknown')}"))
                if why.get("deliberate"):
                    print(s.dim("  deliberate stop - not restarting; that would re-run a decided experiment"))
                elif not restart:
                    print(s.yellow("  not a verdict - would restart, but --watchdog-restart was not given"))
                elif snap["machine"] != MACHINE:
                    print(s.yellow(f"  not a verdict, but it ran on {snap['machine']} - cannot relaunch remotely"))
                else:
                    nxt, note = relaunch(r, RUNS)
                    if nxt:
                        print(s.green(f"  restarted as {nxt}: {note}"))
                        seen_running.add(nxt)
                    else:
                        print(s.red(f"  RESTART FAILED: {note}"))
                sys.stdout.flush()
                time.sleep(6)

        sys.stdout.flush()
        time.sleep(every)


def request_budget_extension(local, increment=5_000_000, runs_dir=RUNS):
    """Ask the one local live trainer to increase its budget; the trainer validates and applies it."""
    active = [run for run in local.get("runs", []) if run.get("running")]
    if len(active) != 1:
        return "budget unchanged: expected exactly one local running job"
    run = active[0]
    current = max(int(run.get("budget") or 0), int(run.get("steps") or 0))
    requested = current + int(increment)
    path = os.path.join(runs_dir, run["name"], "control.json")
    tmp = path + ".tmp"
    try:
        import json
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump({"schema": 1, "budget": requested,
                       "requested_at": datetime.now().astimezone().isoformat(timespec="seconds"),
                       "requested_by": "vxstat"}, fh, indent=2)
        os.replace(tmp, path)
    except OSError as exc:
        return f"budget request failed: {exc}"
    return f"requested {run['name']} budget +{increment / 1_000_000:g}M -> {requested / 1_000_000:g}M"


class WatchKeys:
    """Single-key input for the watch screen, restored cleanly on exit."""
    def __init__(self):
        self._saved = None

    def __enter__(self):
        if not WINDOWS and sys.stdin.isatty():
            try:
                import termios
                import tty
                self._saved = termios.tcgetattr(sys.stdin.fileno())
                tty.setcbreak(sys.stdin.fileno())
            except Exception:
                self._saved = None
        return self

    def read(self):
        try:
            if WINDOWS:
                import msvcrt
                return msvcrt.getwch() if msvcrt.kbhit() else None
            import select
            return sys.stdin.read(1) if sys.stdin.isatty() and select.select([sys.stdin], [], [], 0)[0] else None
        except Exception:
            return None

    def __exit__(self, *_args):
        if self._saved is not None:
            try:
                import termios
                termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, self._saved)
            except Exception:
                pass


def main():
    args = sys.argv[1:]
    plain = "--plain" in args
    watch = "--watch" in args
    as_json = "--json" in args
    explicit_peers = [args[i + 1] for i, a in enumerate(args) if a == "--peer" and i + 1 < len(args)]

    every = 1.0
    if watch:
        i = args.index("--watch")
        if i + 1 < len(args):
            try:
                every = max(0.25, float(args[i + 1]))
            except ValueError:
                pass

    if as_json:
        import json
        print(json.dumps(snapshot()))
        return

    s = Style(not plain and (sys.stdout.isatty() or "--color" in args))
    initial_local = snapshot()
    peers_t = peer_targets(initial_local, explicit_peers)
    poller = Peers(peers_t)
    first_local = [initial_local]
    latest_local = [initial_local]

    def panel():
        local = first_local.pop() if first_local else snapshot()
        latest_local[0] = local
        remote = poller.snapshots()
        return render_jobs(local, remote, s)

    if "--watchdog" in args or "--watchdog-restart" in args:
        watchdog(explicit_peers, every, "--watchdog-restart" in args, s)
        return

    if not watch:
        # A one-shot call has to wait for the first peer fetch; there is nothing cached yet.
        if peers_t:
            time.sleep(2.5)
        print("\n".join(panel()))
        return
    last_size = None
    notice = ""
    try:
        with WatchKeys() as keys:
            if s.on:
                sys.stdout.write("\033[?1049h\033[?25l")
            while True:
                lines = panel()
                footer = f"  refreshing every {every:.0f}s - + add 5M steps - Ctrl-C to exit"
                if notice:
                    footer += " - " + notice
                lines.append(s.dim(footer))
                frame, last_size = live_frame(lines, last_size)
                sys.stdout.write(frame)
                sys.stdout.flush()
                key = keys.read()
                if key in ("+", "="):
                    notice = request_budget_extension(latest_local[0])
                time.sleep(every)
    except KeyboardInterrupt:
        pass
    finally:
        if s.on:
            sys.stdout.write("\033[?25h\033[?1049l")


if __name__ == "__main__":
    main()
