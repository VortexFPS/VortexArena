<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Scoped to modding-sdk/csharp ONLY. The repository's own nuget.config restricts the game to
       nuget.org on purpose; the NativeAOT-LLVM compiler is not published there, so mod projects - and
       nothing else - add Microsoft's dotnet-experimental feed. <clear /> stops this file inheriting
       anything, and stops anything inheriting from it. -->
  <packageSources>
    <clear />
    <add key="dotnet-experimental" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-experimental/nuget/v3/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
