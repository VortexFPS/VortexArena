#!/usr/bin/env python3
"""Live status of Vortex Arena neural-bot training, across machines.

    vxstat                          this machine, one snapshot
    vxstat --peer user@host         also poll that machine, repeatable
    vxstat --watch                  refresh every second until Ctrl-C
    vxstat --watch 5                refresh every 5 seconds
    vxstat --watchdog               watch, and report WHY a run stopped when it does
    vxstat --watchdog-restart       ...and relaunch it when the reason was not a verdict
    vxstat --json                   machine state as JSON (what peers are asked for)
    vxstat --plain                  no colour, for piping

Jobs are shown as a table: one row for the machine running the trainer, then a row for each machine feeding
it hosts, so a run spread over several boxes reads as one thing.

Local state is derived fresh from /proc (or a PowerShell snapshot on Windows) and the run's train.log on
every frame. PEER state is polled on a background thread every few seconds and cached, because an ssh round
trip is 1-2 seconds and fetching inline would cap the whole panel at the speed of the slowest machine. Each
peer row carries its age when stale, so an out-of-date number is visibly out of date rather than quietly
wrong.

Stage timings come from checkpoint mtimes, since the trainer does not timestamp its output: stage N started
when stage N-1's -done.pt was written.
"""
import os
import re
import shutil
import sys
import threading
import time
from datetime import datetime

try:
    from zoneinfo import ZoneInfo
    # The box runs UTC; the person reading this does not. Convert here rather than making them do it.
    EASTERN = ZoneInfo("America/New_York")
except Exception:
    EASTERN = None

# Overridable so this is not welded to one box; the default is the training VM's layout.
RUNS = os.environ.get("VX_RUNS", "/home/vortex/train/runs")

# Training commands record remote simulation addresses, but not their SSH account. Vortex worker VMs use the
# unprivileged `vortex` account; deployments with another account can override this without repeating --peer.
PEER_USER = os.environ.get("VX_PEER_USER", "vortex")
MIN_EVENT_ROWS = 5

# Which box this is. Shown in the header and prefixed to peer output, because once work is spread over
# machines an unlabelled panel cannot be read -- "64 hosts" means nothing without knowing whose.
try:
    MACHINE = os.uname().nodename
except AttributeError:
    MACHINE = os.environ.get("COMPUTERNAME", "?")
CORES = os.cpu_count() or 1


# ---------------------------------------------------------------- process table

WINDOWS = os.name == "nt"

# One PowerShell round trip per render, reused by processes/meminfo/loadavg/uptime.
#
# The Linux path reads /proc, which does not exist on Windows -- and once a worker machine runs Windows, a
# status tool that only works on Linux tells you nothing about half the fleet. Snapshotting once and sharing
# it keeps this to a single subprocess per refresh instead of four.
# The process list is the expensive part and the slowest-changing: host counts and which runs exist move on
# a timescale of minutes. Memory and CPU are wanted every frame and are nearly free through ctypes, so they
# no longer ride along with it. Measured before this split: a single snapshot took 21 SECONDS on Windows,
# because Get-CimInstance Win32_Process has to materialise a command line for every process on the box --
# which is why a panel asked to refresh once a second refreshed about once every eleven.
_WIN_SNAP = {"t": 0.0, "data": None}
PROC_CACHE_SECONDS = 4.0


_WIN_REFRESHING = {"on": False}


def _windows_snapshot():
    """Cached process snapshot; a stale copy is returned instantly while a thread refreshes it.

    Blocking here was the panel freeze: cache expiry put a ~20 s WMI query in the render path every 4 s. Only
    the very first call blocks, because there is nothing to show yet.
    """
    now = time.time()
    data = _WIN_SNAP["data"]
    if data is not None:
        if now - _WIN_SNAP["t"] >= PROC_CACHE_SECONDS and not _WIN_REFRESHING["on"]:
            _WIN_REFRESHING["on"] = True
            threading.Thread(target=_windows_snapshot_fill, daemon=True).start()
        return data
    return _windows_snapshot_fill()


def _windows_snapshot_fill():
    import json
    import subprocess
    ps = (
        "$p = Get-CimInstance Win32_Process -Filter \"Name='dotnet.exe' OR Name='python.exe'\""
        " | Select-Object ProcessId,CommandLine,WorkingSetSize,CreationDate;"
        "$o = Get-CimInstance Win32_OperatingSystem;"
        "$c = (Get-CimInstance Win32_Processor | Measure-Object -Property LoadPercentage -Average).Average;"
        "[pscustomobject]@{procs=$p; freeKB=$o.FreePhysicalMemory; totalKB=$o.TotalVisibleMemorySize;"
        " cpu=$c; now=(Get-Date)} | ConvertTo-Json -Depth 4 -Compress"
    )
    data = {"procs": [], "freeKB": 0, "totalKB": 0, "cpu": 0, "now": None}
    try:
        r = subprocess.run(["powershell", "-NoProfile", "-NonInteractive", "-Command", ps],
                           capture_output=True, text=True, timeout=25)
        if r.stdout.strip():
            data = json.loads(r.stdout)
    except Exception:
        pass
    _WIN_SNAP.update(t=time.time(), data=data)
    _WIN_REFRESHING["on"] = False
    return data


def _win_epoch(v):
    """Win32 CIM dates arrive as /Date(ms)/ through ConvertTo-Json, or as an ISO string."""
    if not v:
        return None
    if isinstance(v, str):
        m = re.search(r"/Date\((\d+)", v)
        if m:
            return int(m.group(1)) / 1000.0
        try:
            return datetime.fromisoformat(v.replace("Z", "+00:00")).timestamp()
        except ValueError:
            return None
    return None


def processes():
    """(pid, cmdline, rss_kb) for every readable process, self excluded.

    Read straight out of /proc rather than shelling to pgrep: a pgrep pattern matches the command line of
    whatever is doing the asking, which has bitten this project repeatedly -- including once where it killed
    the shell that issued it.
    """
    me = os.getpid()
    if WINDOWS:
        snap = _windows_snapshot()
        rows = snap.get("procs") or []
        if isinstance(rows, dict):
            rows = [rows]
        for row in rows:
            pid = row.get("ProcessId") or 0
            cmd = row.get("CommandLine") or ""
            if not cmd or pid == me:
                continue
            yield pid, cmd, int((row.get("WorkingSetSize") or 0) / 1024)
        return
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        pid = int(entry)
        if pid == me:
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as fh:
                cmd = fh.read().decode("utf-8", "replace").replace("\0", " ").strip()
            if not cmd:
                continue
            rss = 0
            with open(f"/proc/{pid}/statm") as fh:
                rss = int(fh.read().split()[1]) * (os.sysconf("SC_PAGE_SIZE") // 1024)
        except (OSError, ValueError, IndexError):
            continue
        yield pid, cmd, rss


def proc_age(pid):
    try:
        return time.time() - os.stat(f"/proc/{pid}").st_mtime
    except OSError:
        return 0.0


def uptime_of(pid):
    """Seconds since the process started, from its own start ticks against system uptime."""
    if WINDOWS:
        rows = _windows_snapshot().get("procs") or []
        if isinstance(rows, dict):
            rows = [rows]
        for row in rows:
            if row.get("ProcessId") == pid:
                started = _win_epoch(row.get("CreationDate"))
                return max(0.0, time.time() - started) if started else 0.0
        return 0.0
    try:
        with open(f"/proc/{pid}/stat") as fh:
            start_ticks = int(fh.read().rsplit(")", 1)[1].split()[19])
        with open("/proc/uptime") as fh:
            up = float(fh.read().split()[0])
        return max(0.0, up - start_ticks / os.sysconf("SC_CLK_TCK"))
    except (OSError, ValueError, IndexError):
        return 0.0


# ---------------------------------------------------------------- machine

def _win_meminfo():
    """Total/free physical memory via GlobalMemoryStatusEx. Microseconds, against ~21 s for the WMI path."""
    import ctypes
    class MEMORYSTATUSEX(ctypes.Structure):
        _fields_ = [("dwLength", ctypes.c_uint32), ("dwMemoryLoad", ctypes.c_uint32),
                    ("ullTotalPhys", ctypes.c_uint64), ("ullAvailPhys", ctypes.c_uint64),
                    ("ullTotalPageFile", ctypes.c_uint64), ("ullAvailPageFile", ctypes.c_uint64),
                    ("ullTotalVirtual", ctypes.c_uint64), ("ullAvailVirtual", ctypes.c_uint64),
                    ("ullAvailExtendedVirtual", ctypes.c_uint64)]
    m = MEMORYSTATUSEX()
    m.dwLength = ctypes.sizeof(MEMORYSTATUSEX)
    if not ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(m)):
        return 0.0, 0.0, 0.0
    total = m.ullTotalPhys / (1024.0 ** 3)
    avail = m.ullAvailPhys / (1024.0 ** 3)
    return total, total - avail, avail


# CPU as a rate between calls, not a load average.
#
# Load average is a one-minute mean, so on a panel refreshing every second it lags far behind what the
# machine is doing -- during an eval the hosts go quiet and loadavg keeps reporting the previous minute's
# work, or reports 0.01 a minute after they stopped. Busy fraction between two samples tracks the actual
# state, and reads the same on both platforms.
_CPU_PREV = {"idle": 0.0, "total": 0.0}


def cpu_busy():
    """Fraction of all cores busy since the previous call, 0..1."""
    if WINDOWS:
        import ctypes
        idle = ctypes.c_uint64()
        kern = ctypes.c_uint64()
        user = ctypes.c_uint64()
        if not ctypes.windll.kernel32.GetSystemTimes(ctypes.byref(idle), ctypes.byref(kern),
                                                     ctypes.byref(user)):
            return 0.0
        # Kernel time INCLUDES idle time on Windows, so total is kernel + user and busy is total - idle.
        idle_t, total_t = float(idle.value), float(kern.value + user.value)
    else:
        try:
            with open("/proc/stat") as fh:
                parts = [float(x) for x in fh.readline().split()[1:]]
        except (OSError, ValueError):
            return 0.0
        idle_t = sum(parts[3:5])
        total_t = sum(parts)

    # The first call has nothing to difference against, so the "delta" spans the whole of uptime -- the
    # average since boot, which on a box that idled for hours reads far below what it is doing now. That is
    # exactly the case that matters, because a peer answers with a single one-shot invocation.
    if _CPU_PREV["total"] == 0.0:
        _CPU_PREV.update(idle=idle_t, total=total_t)
        time.sleep(0.2)
        return cpu_busy()

    d_idle = idle_t - _CPU_PREV["idle"]
    d_total = total_t - _CPU_PREV["total"]
    _CPU_PREV.update(idle=idle_t, total=total_t)
    if d_total <= 0:
        return 0.0
    return max(0.0, min(1.0, 1.0 - d_idle / d_total))


def meminfo():
    if WINDOWS:
        return _win_meminfo()
    vals = {}
    try:
        with open("/proc/meminfo") as fh:
            for line in fh:
                k, _, v = line.partition(":")
                vals[k] = int(v.split()[0])
    except (OSError, ValueError):
        return 0.0, 0.0, 0.0
    total = vals.get("MemTotal", 0) / 1048576.0
    avail = vals.get("MemAvailable", 0) / 1048576.0
    return total, total - avail, avail


def loadavg():
    if WINDOWS:
        # Windows has no load average. CPU percent scaled to cores is the closest comparable number, and it
        # is labelled the same way in the panel so the two machines read alike.
        return (_windows_snapshot().get("cpu") or 0) / 100.0 * CORES
    try:
        with open("/proc/loadavg") as fh:
            return float(fh.read().split()[0])
    except (OSError, ValueError):
        return 0.0


# ---------------------------------------------------------------- log parsing

UPDATE = re.compile(
    r"\[s(?P<stage>\d) u\s*(?P<update>\d+)\]\s+steps\s+(?P<steps>[\d,]+)\s+(?P<sps>[\d.]+)/s"
    r".*?sampled\s+(?P<sampled>[\d.]+)%\s+shipped\s+(?P<shipped>(?:[\d.]+|nan))%"
    r".*?ent\s+(?P<ent>[-\d.]+)\s+kl\s+(?P<kl>[-\d.]+)")
EVAL = re.compile(r"\[s(?P<stage>\d)\].*?eval:\s+(?P<rate>[\d.]+)% arrivals \(gate (?P<gate>[\d.]+)%")
STAGE = re.compile(r"=== stage (?P<stage>\d): (?P<budget>[\d,]+) agent-steps, advance at (?P<gate>[\d.]+)%")

# A baseline belongs to an experiment manifest, not this executable. Hardcoded values drifted away from the
# live map pool and made a healthy policy appear 1.58x better than a reference it had never faced.
BASELINE = {}


def tail(path, n=4000):
    try:
        with open(path, "rb") as fh:
            fh.seek(0, 2)
            size = fh.tell()
            fh.seek(max(0, size - n * 200))
            return fh.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return []


def run_config(run_dir):
    """The run's config.json, flattened across its nested sections.

    The file is {"args": {...}, "hyper": {...}, obs_size, action_logits}, so a top-level get finds nothing.
    Flattening one level keeps the lookup simple and survives a section being renamed or added.
    """
    try:
        import json
        with open(os.path.join(run_dir, "config.json")) as fh:
            raw = json.load(fh)
    except Exception:
        return {}
    flat = {}
    for k, v in raw.items():
        if isinstance(v, dict):
            flat.update(v)
        else:
            flat[k] = v
    return flat


def read_json(path):
    try:
        import json
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError, TypeError):
        return None


def jsonl_tail(path, limit=40):
    rows = []
    for line in tail(path, max(100, limit * 2))[-limit:]:
        try:
            import json
            rows.append(json.loads(line))
        except (ValueError, TypeError):
            continue
    return rows


def seconds_per_update(lines):
    """Wall seconds per update, derived from the log without needing timestamps.

    Each update line carries cumulative steps and a cumulative steps/s, so steps/sps is the elapsed time at
    that line. Differencing two lines gives the wall time between them. Taken over a window rather than a
    single pair, because one update straddling an eval is not representative of the rest.
    """
    seen = {}
    for line in lines:
        m = UPDATE.search(line)
        if m:
            try:
                sps = float(m["sps"])
                if sps > 0:
                    seen[int(m["update"])] = int(m["steps"].replace(",", "")) / sps
            except (ValueError, ZeroDivisionError):
                continue
    if len(seen) < 3:
        return None
    keys = sorted(seen)[-12:]
    du = keys[-1] - keys[0]
    dt = seen[keys[-1]] - seen[keys[0]]
    return dt / du if du > 0 and dt > 0 else None


def past_eval_seconds(lines):
    """Median wall time a completed eval took on this run, or None.

    Derived, not stored. Every update line carries cumulative steps and a cumulative steps/s, so steps/sps is
    the elapsed time at that line -- and the gap between consecutive updates is the wall time between them.
    Most gaps are one update; the ones that also contain an eval are several times longer. Subtracting the
    typical update from those long gaps leaves the eval.
    """
    elapsed = {}
    for line in lines:
        m = UPDATE.search(line)
        if m:
            try:
                sps = float(m["sps"])
                if sps > 0:
                    elapsed[int(m["update"])] = int(m["steps"].replace(",", "")) / sps
            except (ValueError, ZeroDivisionError):
                continue
    keys = sorted(elapsed)
    if len(keys) < 6:
        return None
    gaps = [(elapsed[b] - elapsed[a]) for a, b in zip(keys, keys[1:]) if b - a == 1]
    if len(gaps) < 5:
        return None
    ordered = sorted(gaps)
    spu = ordered[len(ordered) // 2]
    # Anything past three normal updates is an eval stall rather than a slow update.
    stalls = [g - spu for g in gaps if g > spu * 3.0]
    if not stalls:
        return None
    stalls.sort()
    return stalls[len(stalls) // 2]


def parse(lines):
    st = {"update": None, "evals": [], "stage": None, "budget": None, "gate": None,
          "skipped": 0, "diverge": 0, "starved": 0, "relaxed": 0}
    for line in lines:
        m = UPDATE.search(line)
        if m:
            st["update"] = m.groupdict()
        m = EVAL.search(line)
        if m:
            st["evals"].append((int(m["stage"]), float(m["rate"]), float(m["gate"])))
        m = STAGE.search(line)
        if m:
            st["stage"] = int(m["stage"])
            st["budget"] = int(m["budget"].replace(",", ""))
            st["gate"] = float(m["gate"])
        if "SKIPPED" in line:
            st["skipped"] += 1
        if "[diverge]" in line:
            st["diverge"] += 1
        if "no map in the pool" in line:
            st["starved"] += 1
        if "course draws relaxed" in line:
            st["relaxed"] += 1
    return st


# ---------------------------------------------------------------- formatting

# Glyphs degrade to ASCII when stdout cannot carry them: a pipe, an old console, or --ascii. Mojibake in a
# status panel is worse than plain characters, and this file has already been bitten by an em dash once.
def _utf_ok():
    if "--ascii" in sys.argv:
        return False
    enc = (getattr(sys.stdout, "encoding", "") or "").lower()
    return "utf" in enc


if _utf_ok():
    G = {"bar": "\u2503", "band": "\u2501", "fill": "\u2593", "empty": "\u2591",
         "dot": " \u00b7 ", "ok": "\u2713", "run": "\u25cf"}
else:
    G = {"bar": "|", "band": "=", "fill": "#", "empty": ".", "dot": " - ", "ok": "ok", "run": "*"}


def _enable_windows_ansi():
    """Turn on VT processing so ANSI escapes render instead of printing as literal gibberish.

    Windows Terminal does this already; the older console host does not, and the difference is invisible
    until the panel is full of escape codes. Harmless where it is already on.
    """
    if not WINDOWS:
        return
    try:
        import ctypes
        k = ctypes.windll.kernel32
        handle = k.GetStdHandle(-11)           # STD_OUTPUT_HANDLE
        mode = ctypes.c_uint32()
        if k.GetConsoleMode(handle, ctypes.byref(mode)):
            k.SetConsoleMode(handle, mode.value | 0x0004)   # ENABLE_VIRTUAL_TERMINAL_PROCESSING
    except Exception:
        pass


class Style:
    def __init__(self, on):
        self.on = on
        if on:
            _enable_windows_ansi()

    def __call__(self, s, code):
        return f"\033[{code}m{s}\033[0m" if self.on else s

    def dim(self, s):    return self(s, "2")
    def bold(self, s):   return self(s, "1")
    def green(self, s):  return self(s, "32")
    def yellow(self, s): return self(s, "33")
    def red(self, s):    return self(s, "31")
    def cyan(self, s):   return self(s, "36")
    def blue(self, s):   return self(s, "34")
    def magenta(self, s): return self(s, "35")


ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")


def visible_len(text):
    return len(ANSI_RE.sub("", text))


def clip_visible(text, width):
    """Clip a coloured row without cutting an ANSI sequence or allowing terminal line wrapping.

    A wrapped row changes the terminal's physical row count. When the window is resized, reflowed remnants of
    those rows are what produce duplicated dashboard lines, so every live row stays one column shy of the edge.
    """
    if width <= 0:
        return ""
    if visible_len(text) <= width:
        return text
    out = []
    used = 0
    pos = 0
    for match in ANSI_RE.finditer(text):
        chunk = text[pos:match.start()]
        take = min(len(chunk), width - used)
        if take:
            out.append(chunk[:take])
            used += take
        if used >= width:
            break
        out.append(match.group(0))
        pos = match.end()
    else:
        chunk = text[pos:]
        take = min(len(chunk), width - used)
        if take:
            out.append(chunk[:take])
    # A clipped colour span may have lost its reset sequence; reset explicitly so the next row stays clean.
    if ANSI_RE.search(text):
        out.append("\033[0m")
    return "".join(out)


def terminal_size():
    size = shutil.get_terminal_size((110, 30))
    return max(20, size.columns), max(4, size.lines)


def live_frame(lines, previous_size=None):
    """Return a resize-safe ANSI frame and the terminal dimensions used to lay it out."""
    size = terminal_size()
    width = max(1, size[0] - 1)  # writing the final column can trigger an implicit wrap on Windows Terminal
    fitted = [clip_visible(line, width) for line in lines]
    # Never write more physical rows than exist: scrolling defeats cursor-home redraws just like wrapping does.
    fitted = fitted[:size[1]]
    clear = "\033[2J\033[H" if previous_size != size else "\033[H"
    # Cursor-home plus erase-to-end is not enough when a row gets shorter: by the time the final erase runs,
    # the cursor has already moved below that row and its old suffix survives ("waiting on evalon evalt").
    # Clear each physical row before drawing it, and emit CR explicitly because LF-only cursor behaviour
    # differs between Windows console modes.
    rendered = "\n".join("\033[2K\r" + line for line in fitted)
    return clear + rendered + "\033[J", size


def clock_after(seconds):
    when = datetime.fromtimestamp(time.time() + max(0, seconds)).astimezone()
    return when.strftime("%I:%M %p").lstrip("0")


def dur(sec):
    sec = int(sec)
    if sec < 60:
        return f"{sec}s"
    if sec < 3600:
        return f"{sec // 60}m {sec % 60:02d}s"
    return f"{sec // 3600}h {(sec % 3600) // 60:02d}m"


def label(s, text, width=7):
    """Pad before adding ANSI codes so coloured labels do not shift every following column."""
    return s.dim(f"{text:<{width}}")


def bar(frac, width, s):
    frac = max(0.0, min(1.0, frac))
    filled = int(round(frac * width))
    colour = s.green if frac >= 1.0 else (s.cyan if frac >= 0.75 else s.yellow)
    return colour(G["fill"] * filled) + s.dim(G["empty"] * (width - filled))


def trend(vals):
    """Direction of the last few evals, stated only when there are enough to mean anything."""
    if len(vals) < 3:
        return "", ""
    recent, prior = vals[-3:], vals[-6:-3]
    if not prior:
        return "", ""
    delta = sum(recent) / len(recent) - sum(prior) / len(prior)
    if delta > 0.5:
        return "rising", "green"
    if delta < -0.5:
        return "falling", "red"
    return "flat", "yellow"


# ---------------------------------------------------------------- report

def snapshot():
    """This machine's state as plain data.

    Structured rather than pre-rendered, because a peer's numbers have to be laid out in the SAME table as
    the local ones. Shipping formatted text across the wire meant every machine drew its own panel and the
    reader had to correlate them by eye.
    """
    procs = list(processes())
    # Eval shards are the same binary with --bench, and counting them as training hosts overstates the
    # fleet exactly when it is doing the least work -- a run with --hosts 0 appeared to have four.
    hosts = [(p, r) for p, c, r in procs if "va-neural-host.dll" in c and "--bench" not in c]
    benches = [1 for _, c, _ in procs if "va-neural-host.dll" in c and "--bench" in c]
    tests = sum(1 for _, c, _ in procs if "dotnet" in c.lower() and " test " in c.lower())
    experiments = sum(1 for _, c, _ in procs
                      if ("--bench" in c and "--policy" not in c) or "pytest" in c.lower())
    total, used, free = meminfo()

    snap = {
        "machine": MACHINE,
        "cores": CORES,
        "hosts": len(hosts),
        "benches": sum(benches),
        "worst_host_mb": max((r for _, r in hosts), default=0) / 1024.0,
        "ram_used": used, "ram_total": total, "ram_free": free,
        "cpu": cpu_busy(),
        "agents_per_host": 16,
        "eval_shards_running": sum(benches),
        "tests_running": tests,
        "experiments_running": experiments,
        "work": ("evaluation" if benches else "training rollout" if hosts else
                 "test suite" if tests else "experiment" if experiments else "idle"),
        "runs": [],
    }

    # The EXECUTABLE must be python, not merely mentioned. A wrapper such as `nohup python train.py ...`
    # carries both words in its command line and would otherwise be counted as a second copy of the same run.
    trainers = []
    seen_names = set()
    for p, c, _ in procs:
        if "train.py" not in c or " -c " in c:
            continue
        head = c.split()[0].strip('"').lower() if c.split() else ""
        if "python" not in os.path.basename(head):
            continue
        name = (re.search(r"--name (\S+)", c) or [None, "?"])[1]
        if name in seen_names:
            continue
        seen_names.add(name)
        trainers.append((p, c))
        snap["runs"].append(run_snapshot(name, p, uptime_of(p), c, procs, True))

    if not trainers and snap["hosts"] == 0:
        # Nothing training AND nothing serving. A machine with hosts but no trainer is a worker for someone
        # else's job, and its last finished run is not what it is doing now -- showing it there implies work
        # that is not happening and counts its hosts twice, once here and once under the job they serve.
        try:
            logs = sorted(((os.path.getmtime(os.path.join(RUNS, d, "train.log")), d)
                           for d in os.listdir(RUNS)
                           if os.path.exists(os.path.join(RUNS, d, "train.log"))), reverse=True)
        except OSError:
            logs = []
        if logs:
            snap["runs"].append(run_snapshot(logs[0][1], None, 0, "", procs, False))
    return snap


def run_snapshot(name, pid, up, cmd, procs, running):
    run_dir = os.path.join(RUNS, name)
    lines = tail(os.path.join(run_dir, "train.log"))
    st = parse(lines)
    u = st["update"]
    stage = int(u["stage"]) if u else (st["stage"] or 0)
    rates = [r for sg, r, _ in st["evals"] if sg == stage]
    gate = st["gate"] or (st["evals"][-1][2] if st["evals"] else 0.0)
    cfg = run_config(run_dir)
    structured = read_json(os.path.join(run_dir, "state.json")) or {}
    metric_rows = jsonl_tail(os.path.join(run_dir, "metrics.jsonl"), 200)
    structured_evals = [m for m in metric_rows if m.get("type") == "evaluation"
                        and int(m.get("stage", -1)) == int(structured.get("stage", stage))]
    if structured:
        stage = int(structured.get("stage", stage))
        steps_struct = structured.get("stage_steps")
        if steps_struct is not None:
            st["budget"] = int(structured.get("budget", st["budget"] or 0))
            gate_value = float(structured.get("gate", 0))
            st["gate"] = gate_value * 100.0 if gate_value <= 1.0 else gate_value
    gate = st["gate"] or gate

    try:
        every = int(cfg.get("eval_every", 0))
    except (TypeError, ValueError):
        every = 0
    shards = [p for p, c, _ in procs if "va-neural-host.dll" in c and "--bench" in c and "--policy" in c]
    try:
        total_shards = int(cfg.get("eval_shards", 0)) or len(shards)
    except (TypeError, ValueError):
        total_shards = len(shards)

    steps = int(structured.get("stage_steps", int(u["steps"].replace(",", "")) if u else 0))
    spu = seconds_per_update(lines)
    eval_secs = past_eval_seconds(lines)
    durations = [float(m["eval_seconds"]) for m in metric_rows
                 if m.get("type") == "evaluation" and m.get("eval_seconds") is not None]
    if durations:
        ordered_durations = sorted(durations[-9:])
        eval_secs = ordered_durations[len(ordered_durations) // 2]
    try:
        expected = float(structured.get("eval_expected_seconds", 0))
        if expected > 0:
            eval_secs = expected
    except (TypeError, ValueError):
        pass

    eval_in_flight = bool(structured.get("eval_in_flight"))
    eval_progress = read_json(os.path.join(run_dir, "eval-progress.json")) or {}
    progress_shards = eval_progress.get("shards") or []
    # Ignore a leftover progress file once no evaluation is active. During an eval it is authoritative:
    # process counting alone can say only running/done, not whether counters are moving or a shard retried.
    if not eval_in_flight:
        progress_shards = []
    elif progress_shards:
        total_shards = len(progress_shards)
    try:
        eval_started_epoch = float(structured.get("eval_started_epoch", 0))
    except (TypeError, ValueError):
        eval_started_epoch = 0.0
    eval_elapsed = (max(0.0, time.time() - eval_started_epoch) if eval_in_flight and eval_started_epoch
                    else max((uptime_of(p) for p in shards), default=0.0))

    # Which other machines are feeding this run. The trainer's own command line is the only place this is
    # recorded, and it is what lets a job be shown as one row per participating machine.
    remotes = []
    for spec in re.findall(r"--remote (\S+)", cmd or ""):
        parts = spec.split(":")
        if len(parts) >= 2:
            remotes.append({"addr": parts[0], "count": int(parts[2]) if len(parts) > 2 else 1})

    if structured_evals:
        rates = [float(m["arrival_rate"]) * 100.0 for m in structured_evals
                 if m.get("arrival_rate") is not None]
    events = jsonl_tail(os.path.join(run_dir, "events.jsonl"), 8)
    try:
        agents_per_host = int(cfg.get("agents", 16))
    except (TypeError, ValueError):
        agents_per_host = 16

    stopped_reason = None
    if not running:
        phase = str(structured.get("phase", ""))
        if phase == "stopped":
            stopped_reason = {"key": "paused", "text": "paused with a completed checkpoint",
                              "deliberate": True}
        elif phase == "stopped_eval_failure":
            stopped_reason = {"key": "eval", "text": "paused after repeated evaluation failures",
                              "deliberate": False}
        else:
            stopped_reason = stop_reason(lines)

    return {
        "name": name, "running": running, "up": up, "stage": stage,
        "best": (float(structured.get("best_rate")) * 100.0
                 if structured.get("best_rate") is not None else max(rates) if rates else None),
        "best_time": structured.get("best_time"),
        "last": rates[-24:],
        "gate": gate,
        "baseline": BASELINE.get(stage),
        "steps": steps, "budget": st["budget"] or 0,
        "sps": float(u["sps"]) if u else 0.0,
        "update": int(structured.get("update", int(u["update"]) if u else 0)),
        "entropy": float(u["ent"]) if u else 0.0,
        "kl": float(u["kl"]) if u else 0.0,
        "sampled": float(u["sampled"]) if u else 0.0,
        "skipped": st["skipped"], "diverge": st["diverge"],
        "starved": st["starved"], "relaxed": st["relaxed"],
        "eval_every": every, "eval_secs": eval_secs, "spu": spu,
        "eval_timeout_secs": structured.get("eval_timeout_seconds"),
        "next_eval_update": structured.get("next_eval_update"),
        "eval_running": eval_in_flight or len(shards) > 0,
        "eval_done": (sum(1 for shard in progress_shards if shard.get("status") == "complete")
                      if progress_shards else max(0, total_shards - len(shards)) if shards else 0),
        "eval_total": total_shards,
        "eval_shards": progress_shards,
        "eval_elapsed": eval_elapsed,
        "phase": structured.get("phase", "evaluating" if shards else "training" if running else "stopped"),
        "events": events,
        "agents_per_host": agents_per_host,
        "remotes": remotes,
        "local_hosts_flag": _int_arg(cmd, "--hosts"),
        "cmd": cmd,
        "stopped_reason": stopped_reason,
    }


# Ordered most-specific first: a run that diverged AND then printed the gate verdict stopped because it
# diverged, and reporting the verdict would hide the failure behind a normal-looking sentence.
STOP_PATTERNS = [
    ("traceback",  r"^Traceback \(most recent call last\)",           False, "crashed with a traceback"),
    ("diverged",   r"^\[s\d\] ABORTING: (\d+) consecutive updates",     False, "diverged: every minibatch non-finite"),
    ("starved",    r"no map in the pool produced a reachable",       False, "course starvation"),
    ("gate",       r"did not reach \d+%; stopping",                   True,  "finished the stage under its gate"),
    ("passed",     r"=== stage \d+:",                                 True,  "advanced a stage"),
    ("done",       r"##########.*DONE",                               True,  "curriculum finished"),
]


def stop_reason(lines):
    """(key, human text, deliberate?) for why a finished run finished, or None if it just vanished."""
    import re as _re
    tail = lines[-400:]
    for key, pat, deliberate, text in STOP_PATTERNS:
        for line in reversed(tail):
            if _re.search(pat, line):
                return {"key": key, "text": text, "deliberate": deliberate}
    return {"key": "vanished", "text": "process gone, no verdict in the log", "deliberate": False}


def _int_arg(cmd, flag):
    m = re.search(re.escape(flag) + r" (\d+)", cmd or "")
    return int(m.group(1)) if m else None


# ---------------------------------------------------------------- peers

class Peers:
    """Background poller for other machines.

    Refreshed on its own slow cadence while the panel redraws fast. An ssh round trip is 1-2 seconds, so
    fetching inline would cap the refresh rate at the speed of the slowest machine -- the panel would stutter
    for a number that only changes every few seconds anyway. Each entry carries its age so a stale peer is
    visibly stale rather than quietly wrong.
    """

    def __init__(self, targets, period=5.0):
        self.targets = targets
        self.period = period
        self.data = {t: {"snap": None, "at": 0.0, "err": "connecting"} for t in targets}
        self._stop = False
        if targets:
            import threading
            self._thread = threading.Thread(target=self._loop, daemon=True)
            self._thread.start()

    def _fetch(self, target):
        import json
        import subprocess
        try:
            r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", target,
                                "vxstat --json"],
                               capture_output=True, text=True, timeout=20)
            if not r.stdout.strip():
                return None, (r.stderr.strip().splitlines() or ["no output"])[-1][:40]
            return json.loads(r.stdout), None
        except subprocess.TimeoutExpired:
            return None, "timeout"
        except Exception as exc:
            return None, type(exc).__name__

    def _loop(self):
        while not self._stop:
            # Peers are independent. Polling them serially made a dead box delay every healthy one by its
            # full SSH timeout and left the fleet panel several refreshes behind reality.
            from concurrent.futures import ThreadPoolExecutor
            with ThreadPoolExecutor(max_workers=min(8, len(self.targets))) as pool:
                results = list(zip(self.targets, pool.map(self._fetch, self.targets)))
            for t, (snap, err) in results:
                if snap is not None:
                    self.data[t] = {"snap": snap, "at": time.time(), "err": None}
                else:
                    self.data[t]["err"] = err
            time.sleep(self.period)

    def snapshots(self):
        out = []
        for t in self.targets:
            d = self.data[t]
            if d["snap"] is not None:
                s = dict(d["snap"])
                s["age"] = time.time() - d["at"]
                s["target"] = t
                out.append(s)
            else:
                out.append({"machine": t, "unreachable": d["err"], "runs": [], "hosts": 0,
                            "ram_used": 0, "ram_total": 0, "ram_free": 0, "load": 0, "cores": 0,
                            "target": t, "age": 0})
        return out


def peer_targets(local, explicit=()):
    """Combine requested peers with worker addresses already declared by the active training command."""
    targets = []
    hosts = set()

    def add(target):
        target = str(target).strip()
        if not target:
            return
        host = target.rsplit("@", 1)[-1]
        if host in hosts:
            return
        hosts.add(host)
        targets.append(target)

    # An explicit target wins when it names the same host with a different SSH account or alias.
    for target in explicit:
        add(target)
    for run in local.get("runs", []):
        for remote in run.get("remotes", []):
            addr = str(remote.get("addr", "")).strip()
            if not addr or addr.rsplit("@", 1)[-1] in hosts:
                continue
            add(addr if "@" in addr or not PEER_USER else f"{PEER_USER}@{addr}")
    return targets


