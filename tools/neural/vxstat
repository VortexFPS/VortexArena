#!/usr/bin/env python3
"""Live status of the Vortex Arena neural-bot training run.

    vxstat                one snapshot and exit
    vxstat --watch        refresh every 5 s until Ctrl-C
    vxstat --watch 15     refresh every 15 s
    vxstat --plain        no colour, no box drawing (for piping or logging)

Everything is derived fresh from /proc and the run's train.log on every call. There is deliberately no
daemon and no cached state: a background collector is one more thing that can die quietly and leave a
confident-looking stale number on the screen, and nothing here is expensive enough to be worth that risk.

Stage timings come from checkpoint mtimes rather than the log, because the trainer does not timestamp its
output -- stage N started when stage N-1's -done.pt was written.
"""
import os
import re
import sys
import time
from datetime import datetime

try:
    from zoneinfo import ZoneInfo
    # The box runs UTC; the person reading this does not. Convert here rather than making them do it.
    EASTERN = ZoneInfo("America/New_York")
except Exception:
    EASTERN = None

# Overridable so this is not welded to one box; the default is the training VM's layout.
RUNS = os.environ.get("VX_RUNS", "/home/vortex/train/runs")

# Which box this is. Shown in the header and prefixed to peer output, because once work is spread over
# machines an unlabelled panel cannot be read -- "64 hosts" means nothing without knowing whose.
try:
    MACHINE = os.uname().nodename
except AttributeError:
    MACHINE = os.environ.get("COMPUTERNAME", "?")
CORES = os.cpu_count() or 1


# ---------------------------------------------------------------- process table

WINDOWS = os.name == "nt"

# One PowerShell round trip per render, reused by processes/meminfo/loadavg/uptime.
#
# The Linux path reads /proc, which does not exist on Windows -- and once a worker machine runs Windows, a
# status tool that only works on Linux tells you nothing about half the fleet. Snapshotting once and sharing
# it keeps this to a single subprocess per refresh instead of four.
_WIN_SNAP = {"t": 0.0, "data": None}


def _windows_snapshot():
    import json
    import subprocess
    now = time.time()
    if _WIN_SNAP["data"] is not None and now - _WIN_SNAP["t"] < 1.0:
        return _WIN_SNAP["data"]
    ps = (
        "$p = Get-CimInstance Win32_Process | Select-Object ProcessId,CommandLine,WorkingSetSize,CreationDate;"
        "$o = Get-CimInstance Win32_OperatingSystem;"
        "$c = (Get-CimInstance Win32_Processor | Measure-Object -Property LoadPercentage -Average).Average;"
        "[pscustomobject]@{procs=$p; freeKB=$o.FreePhysicalMemory; totalKB=$o.TotalVisibleMemorySize;"
        " cpu=$c; now=(Get-Date)} | ConvertTo-Json -Depth 4 -Compress"
    )
    data = {"procs": [], "freeKB": 0, "totalKB": 0, "cpu": 0, "now": None}
    try:
        r = subprocess.run(["powershell", "-NoProfile", "-NonInteractive", "-Command", ps],
                           capture_output=True, text=True, timeout=25)
        if r.stdout.strip():
            data = json.loads(r.stdout)
    except Exception:
        pass
    _WIN_SNAP.update(t=now, data=data)
    return data


def _win_epoch(v):
    """Win32 CIM dates arrive as /Date(ms)/ through ConvertTo-Json, or as an ISO string."""
    if not v:
        return None
    if isinstance(v, str):
        m = re.search(r"/Date\((\d+)", v)
        if m:
            return int(m.group(1)) / 1000.0
        try:
            return datetime.fromisoformat(v.replace("Z", "+00:00")).timestamp()
        except ValueError:
            return None
    return None


def processes():
    """(pid, cmdline, rss_kb) for every readable process, self excluded.

    Read straight out of /proc rather than shelling to pgrep: a pgrep pattern matches the command line of
    whatever is doing the asking, which has bitten this project repeatedly -- including once where it killed
    the shell that issued it.
    """
    me = os.getpid()
    if WINDOWS:
        snap = _windows_snapshot()
        rows = snap.get("procs") or []
        if isinstance(rows, dict):
            rows = [rows]
        for row in rows:
            pid = row.get("ProcessId") or 0
            cmd = row.get("CommandLine") or ""
            if not cmd or pid == me:
                continue
            yield pid, cmd, int((row.get("WorkingSetSize") or 0) / 1024)
        return
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        pid = int(entry)
        if pid == me:
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as fh:
                cmd = fh.read().decode("utf-8", "replace").replace("\0", " ").strip()
            if not cmd:
                continue
            rss = 0
            with open(f"/proc/{pid}/statm") as fh:
                rss = int(fh.read().split()[1]) * (os.sysconf("SC_PAGE_SIZE") // 1024)
        except (OSError, ValueError, IndexError):
            continue
        yield pid, cmd, rss


def proc_age(pid):
    try:
        return time.time() - os.stat(f"/proc/{pid}").st_mtime
    except OSError:
        return 0.0


def uptime_of(pid):
    """Seconds since the process started, from its own start ticks against system uptime."""
    if WINDOWS:
        rows = _windows_snapshot().get("procs") or []
        if isinstance(rows, dict):
            rows = [rows]
        for row in rows:
            if row.get("ProcessId") == pid:
                started = _win_epoch(row.get("CreationDate"))
                return max(0.0, time.time() - started) if started else 0.0
        return 0.0
    try:
        with open(f"/proc/{pid}/stat") as fh:
            start_ticks = int(fh.read().rsplit(")", 1)[1].split()[19])
        with open("/proc/uptime") as fh:
            up = float(fh.read().split()[0])
        return max(0.0, up - start_ticks / os.sysconf("SC_CLK_TCK"))
    except (OSError, ValueError, IndexError):
        return 0.0


# ---------------------------------------------------------------- machine

def meminfo():
    if WINDOWS:
        snap = _windows_snapshot()
        total = (snap.get("totalKB") or 0) / 1048576.0
        avail = (snap.get("freeKB") or 0) / 1048576.0
        return total, total - avail, avail
    vals = {}
    try:
        with open("/proc/meminfo") as fh:
            for line in fh:
                k, _, v = line.partition(":")
                vals[k] = int(v.split()[0])
    except (OSError, ValueError):
        return 0.0, 0.0, 0.0
    total = vals.get("MemTotal", 0) / 1048576.0
    avail = vals.get("MemAvailable", 0) / 1048576.0
    return total, total - avail, avail


def loadavg():
    if WINDOWS:
        # Windows has no load average. CPU percent scaled to cores is the closest comparable number, and it
        # is labelled the same way in the panel so the two machines read alike.
        return (_windows_snapshot().get("cpu") or 0) / 100.0 * CORES
    try:
        with open("/proc/loadavg") as fh:
            return float(fh.read().split()[0])
    except (OSError, ValueError):
        return 0.0


# ---------------------------------------------------------------- log parsing

UPDATE = re.compile(
    r"\[s(?P<stage>\d) u\s*(?P<update>\d+)\]\s+steps\s+(?P<steps>[\d,]+)\s+(?P<sps>[\d.]+)/s"
    r".*?sampled\s+(?P<sampled>[\d.]+)%\s+shipped\s+(?P<shipped>[\d.]+)%"
    r".*?ent\s+(?P<ent>[-\d.]+)\s+kl\s+(?P<kl>[-\d.]+)")
EVAL = re.compile(r"\[s(?P<stage>\d)\].*?eval:\s+(?P<rate>[\d.]+)% arrivals \(gate (?P<gate>[\d.]+)%")
STAGE = re.compile(r"=== stage (?P<stage>\d): (?P<budget>[\d,]+) agent-steps, advance at (?P<gate>[\d.]+)%")

# Baselines re-measured on the FILTERED course pool, 3 seeds x 800 agent-episodes. Stages without a figure
# here were never re-measured after the filters landed, and their gates should not be trusted until they are.
BASELINE = {2: 28.9, 3: 38.5}


def tail(path, n=4000):
    try:
        with open(path, "rb") as fh:
            fh.seek(0, 2)
            size = fh.tell()
            fh.seek(max(0, size - n * 200))
            return fh.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return []


def run_config(run_dir):
    """The run's config.json, flattened across its nested sections.

    The file is {"args": {...}, "hyper": {...}, obs_size, action_logits}, so a top-level get finds nothing.
    Flattening one level keeps the lookup simple and survives a section being renamed or added.
    """
    try:
        import json
        with open(os.path.join(run_dir, "config.json")) as fh:
            raw = json.load(fh)
    except Exception:
        return {}
    flat = {}
    for k, v in raw.items():
        if isinstance(v, dict):
            flat.update(v)
        else:
            flat[k] = v
    return flat


def seconds_per_update(lines):
    """Wall seconds per update, derived from the log without needing timestamps.

    Each update line carries cumulative steps and a cumulative steps/s, so steps/sps is the elapsed time at
    that line. Differencing two lines gives the wall time between them. Taken over a window rather than a
    single pair, because one update straddling an eval is not representative of the rest.
    """
    seen = {}
    for line in lines:
        m = UPDATE.search(line)
        if m:
            try:
                sps = float(m["sps"])
                if sps > 0:
                    seen[int(m["update"])] = int(m["steps"].replace(",", "")) / sps
            except (ValueError, ZeroDivisionError):
                continue
    if len(seen) < 3:
        return None
    keys = sorted(seen)[-12:]
    du = keys[-1] - keys[0]
    dt = seen[keys[-1]] - seen[keys[0]]
    return dt / du if du > 0 and dt > 0 else None


def past_eval_seconds(lines):
    """Median wall time a completed eval took on this run, or None.

    Derived, not stored. Every update line carries cumulative steps and a cumulative steps/s, so steps/sps is
    the elapsed time at that line -- and the gap between consecutive updates is the wall time between them.
    Most gaps are one update; the ones that also contain an eval are several times longer. Subtracting the
    typical update from those long gaps leaves the eval.
    """
    elapsed = {}
    for line in lines:
        m = UPDATE.search(line)
        if m:
            try:
                sps = float(m["sps"])
                if sps > 0:
                    elapsed[int(m["update"])] = int(m["steps"].replace(",", "")) / sps
            except (ValueError, ZeroDivisionError):
                continue
    keys = sorted(elapsed)
    if len(keys) < 6:
        return None
    gaps = [(elapsed[b] - elapsed[a]) for a, b in zip(keys, keys[1:]) if b - a == 1]
    if len(gaps) < 5:
        return None
    ordered = sorted(gaps)
    spu = ordered[len(ordered) // 2]
    # Anything past three normal updates is an eval stall rather than a slow update.
    stalls = [g - spu for g in gaps if g > spu * 3.0]
    if not stalls:
        return None
    stalls.sort()
    return stalls[len(stalls) // 2]


def parse(lines):
    st = {"update": None, "evals": [], "stage": None, "budget": None, "gate": None,
          "skipped": 0, "diverge": 0, "starved": 0, "relaxed": 0}
    for line in lines:
        m = UPDATE.search(line)
        if m:
            st["update"] = m.groupdict()
        m = EVAL.search(line)
        if m:
            st["evals"].append((int(m["stage"]), float(m["rate"]), float(m["gate"])))
        m = STAGE.search(line)
        if m:
            st["stage"] = int(m["stage"])
            st["budget"] = int(m["budget"].replace(",", ""))
            st["gate"] = float(m["gate"])
        if "SKIPPED" in line:
            st["skipped"] += 1
        if "[diverge]" in line:
            st["diverge"] += 1
        if "no map in the pool" in line:
            st["starved"] += 1
        if "course draws relaxed" in line:
            st["relaxed"] += 1
    return st


# ---------------------------------------------------------------- formatting

class Style:
    def __init__(self, on):
        self.on = on

    def __call__(self, s, code):
        return f"\033[{code}m{s}\033[0m" if self.on else s

    def dim(self, s):    return self(s, "2")
    def bold(self, s):   return self(s, "1")
    def green(self, s):  return self(s, "32")
    def yellow(self, s): return self(s, "33")
    def red(self, s):    return self(s, "31")
    def cyan(self, s):   return self(s, "36")


def dur(sec):
    sec = int(sec)
    if sec < 60:
        return f"{sec}s"
    if sec < 3600:
        return f"{sec // 60}m {sec % 60:02d}s"
    return f"{sec // 3600}h {(sec % 3600) // 60:02d}m"


def bar(frac, width, s):
    frac = max(0.0, min(1.0, frac))
    filled = int(round(frac * width))
    body = "#" * filled + "." * (width - filled)
    colour = s.green if frac >= 1.0 else (s.cyan if frac >= 0.75 else s.yellow)
    return colour(body)


def trend(vals):
    """Direction of the last few evals, stated only when there are enough to mean anything."""
    if len(vals) < 3:
        return "", ""
    recent, prior = vals[-3:], vals[-6:-3]
    if not prior:
        return "", ""
    delta = sum(recent) / len(recent) - sum(prior) / len(prior)
    if delta > 0.5:
        return "rising", "green"
    if delta < -0.5:
        return "falling", "red"
    return "flat", "yellow"


# ---------------------------------------------------------------- report

def render(s):
    out = []
    w = out.append

    procs = list(processes())
    trainers = [(p, c) for p, c, _ in procs
                if "train.py" in c and "python" in c and " -c " not in c]
    hosts = [(p, r) for p, c, r in procs if "va-neural-host.dll" in c]
    benches = [1 for _, c, _ in procs if "va-neural-host.dll" in c and "--bench" in c]

    # %-I is a glibc extension that silently misbehaves on Windows, so strip the zero by hand. And Windows
    # Python ships no IANA database, so ZoneInfo("America/New_York") is unavailable there -- in which case
    # say "local" rather than stamping ET on a time that has not been converted to it.
    if EASTERN:
        now = datetime.now(EASTERN).strftime("%I:%M:%S %p ET").lstrip("0")
    else:
        now = datetime.now().strftime("%I:%M:%S %p local").lstrip("0")
    w(s.bold(f"VORTEX NEURAL TRAINING") + s.dim(f"   {MACHINE}   {now}"))
    w("")

    # Every trainer on this box, not just the first. Two runs at once is now normal -- one machine can be
    # working a curriculum while another runs an A/B -- and a panel that silently showed one of them would
    # be worse than one that showed neither.
    for idx, (pid, cmd) in enumerate(trainers):
        if idx:
            w("")
        name = (re.search(r"--name (\S+)", cmd) or [None, "?"])[1]
        render_run(s, w, name, pid, uptime_of(pid), s.green("RUNNING"), procs, hosts)

    if not trainers:
        # Nothing training: fall back to the most recently touched run so the screen still says something.
        logs = sorted(((os.path.getmtime(os.path.join(RUNS, d, "train.log")), d)
                       for d in os.listdir(RUNS)
                       if os.path.exists(os.path.join(RUNS, d, "train.log"))), reverse=True)
        if not logs:
            w(s.red("no runs found under " + RUNS))
        else:
            render_run(s, w, logs[0][1], None, 0,
                       s.red("STOPPED") + s.dim(f"  (last touched {dur(time.time() - logs[0][0])} ago)"),
                       procs, hosts)

    render_machine(s, w, hosts, benches)
    return "\n".join(out)


def render_run(s, w, name, pid, up, state, procs, hosts):
    run_dir = os.path.join(RUNS, name)
    st = parse(tail(os.path.join(run_dir, "train.log")))
    u = st["update"]
    stage = int(u["stage"]) if u else (st["stage"] or 0)

    # Stage clock from checkpoint mtimes: stage N began when stage N-1's -done.pt was written.
    stage_up = up
    done_prev = os.path.join(run_dir, f"stage{stage - 1}-done.pt")
    if os.path.exists(done_prev):
        stage_up = time.time() - os.path.getmtime(done_prev)

    # Padded before colouring: escape codes count toward str width and would skew every column.
    w(f"  {'RUN':<8} {s.cyan(f'{name:<12}')} up {dur(up):<10}  {state}")

    gate = st["gate"] or (st["evals"][-1][2] if st["evals"] else 0.0)
    base = BASELINE.get(stage)
    ratio = f"baseline {base}% ({gate / base:.2f}x)" if base and gate else s.dim("baseline not re-measured")
    w(f"  {'STAGE':<8} {f'{stage} of 6':<12} up {dur(stage_up):<10}  gate {gate:.1f}%   {ratio}")
    w("")

    # ---- progress
    rates = [r for sg, r, _ in st["evals"] if sg == stage]
    w(s.bold("  PROGRESS"))
    if rates:
        best = max(rates)
        direction, colour = trend(rates)
        tag = getattr(s, colour)(direction) if direction else ""
        w(f"    best        {s.bold(f'{best:5.1f}%')}  {bar(best / gate if gate else 0, 22, s)}  "
          f"{best / gate * 100 if gate else 0:3.0f}% of gate")
        w(f"    last evals  " + "  ".join(f"{r:.1f}" for r in rates[-6:]) + f"   {tag}")
        if base:
            w(f"    vs scripted {best / base:.2f}x baseline")
    else:
        w(s.dim("    no eval on this stage yet"))

    if u:
        steps = int(u["steps"].replace(",", ""))
        budget = st["budget"] or 0
        sps = float(u["sps"])
        eta = (budget - steps) / sps if sps > 0 and budget > steps else 0
        pct = steps / budget if budget else 0
        w(f"    steps       {steps / 1e6:5.1f}M / {budget / 1e6:.0f}M  {bar(pct, 22, s)}  {pct * 100:3.0f}%"
          + (f"   ETA {dur(eta)}" if eta else ""))
        w(f"    throughput  {sps:,.0f} steps/s      sampled {float(u['sampled']):.1f}%"
          f"      update #{int(u['update']):,}")

        # ---- next eval
        #
        # The number worth planning around: an eval is the only thing that produces a score, and between them
        # nothing observable changes. Shards are detected by process rather than by log line, because the
        # trainer prints nothing until the eval finishes.
        cfg = run_config(run_dir)
        try:
            every = int(cfg.get("eval_every", 0))
        except (TypeError, ValueError):
            every = 0
        shards = [p for p, c, _ in procs if "va-neural-host.dll" in c and "--bench" in c and "--policy" in c]
        try:
            total_shards = int(cfg.get("eval_shards", 0)) or len(shards)
        except (TypeError, ValueError):
            total_shards = len(shards)
        typical = past_eval_seconds(tail(os.path.join(run_dir, "train.log")))

        if shards:
            # The shards run CONCURRENTLY, so this is how many have finished, not which one is being worked
            # on. The eval ends when the last one does, which is why the estimate tracks the slowest.
            elapsed = max(uptime_of(p) for p in shards)
            done = max(0, total_shards - len(shards))
            left = f"  ~{dur(max(0.0, typical - elapsed))} left" if typical and typical > elapsed else ""
            of = f" of ~{dur(typical)}" if typical else ""
            w(f"    next eval   {s.cyan('RUNNING NOW')}  {done}/{total_shards} shards done, "
              f"{dur(elapsed)}{of} elapsed{left}")
        elif every > 0:
            done = int(u["update"])
            togo = every - (done % every)
            spu = seconds_per_update(tail(os.path.join(run_dir, "train.log")))
            eta = f"  ~{dur(togo * spu)}" if spu else ""
            w(f"    next eval   in {togo} update{'s' if togo != 1 else ''}{eta}"
              f"   {bar((every - togo) / every, 14, s)}")
            if typical:
                # What each score costs, since it is training time that is not being spent training.
                share = typical / (typical + every * spu) * 100.0 if spu else 0.0
                w(f"    eval cost   ~{dur(typical)} each"
                  + (f", {share:.0f}% of the cycle" if share else "")
                  + f"   ({total_shards} shards in parallel)")
        w("")
        w(s.bold("  MODEL"))
        ent, kl = float(u["ent"]), float(u["kl"])
        # Entropy near zero with everything else flat is what a diverged run looks like from the outside.
        ent_s = s.red(f"{ent:.3f}") if ent < 0.05 else f"{ent:.3f}"
        w(f"    entropy {ent_s}      kl {kl:.4f}      shipped {float(u['shipped']):.1f}%")
    w("")

    # ---- health
    w(s.bold("  HEALTH"))
    checks = [("skipped minibatches", st["skipped"]), ("divergence dumps", st["diverge"]),
              ("course starvation", st["starved"]), ("relaxation warnings", st["relaxed"])]
    for label, n in checks:
        mark = s.green("ok") if n == 0 else s.red(f"{n}  <-- investigate")
        w(f"    {label:<22} {mark}")
    w("")

    render_stages(s, w, run_dir, st, stage, up, pid)


def render_machine(s, w, hosts, benches):
    total, used, free = meminfo()
    load = loadavg()
    worst = max((r for _, r in hosts), default=0) / 1024.0
    ram_s = f"{used:.1f} / {total:.1f} GB used, {free:.1f} GB free"
    if free < 2.0:
        ram_s = s.red(ram_s)
    elif free < 5.0:
        ram_s = s.yellow(ram_s)
    w(s.bold("  MACHINE"))
    w(f"    hosts     {len(hosts)} running"
      + (s.yellow(f"   ({sum(benches)} of them benches)") if benches else "")
      + f"      worst RSS {worst:.0f} MB")
    w(f"    ram       {ram_s}")
    w(f"    load      {load:.1f} of {CORES} cores")

def render_stages(s, w, run_dir, st, stage, up, pid):
    """Stage history from the -done.pt mtimes: stage N began when stage N-1's checkpoint was written."""
    marks = []
    for n in range(1, 7):
        p = os.path.join(run_dir, f"stage{n}-done.pt")
        if os.path.exists(p):
            marks.append((n, os.path.getmtime(p)))
    if marks or stage:
        w("")
        w(s.bold("  STAGES"))
        # The run's own start anchors the first stage; a resumed run enters mid-curriculum, so anything
        # before the first -done.pt happened in an earlier run and is not this run's time to claim.
        prev = time.time() - up if pid else (marks[0][1] if marks else time.time())
        for n, done in marks:
            best_n = max((r for sg, r, _ in st["evals"] if sg == n), default=None)
            rate = f"cleared at {best_n:.1f}%" if best_n is not None else "cleared"
            w(f"    stage {n}   {dur(done - prev):<10} {s.green(rate)}")
            prev = done
        if stage and (not marks or marks[-1][0] < stage):
            w(f"    stage {stage}   {dur(time.time() - prev):<10} {s.cyan('running')}")


def peer_panel(target, plain):
    """Another machine's panel, fetched over ssh.

    A shell-out rather than a daemon, deliberately: ssh already handles auth and transport, vxstat is
    already on the far box, and a status tool needing its own service per machine is one nobody keeps
    running. A peer that is down or prompting shows as a line, never as a hang.
    """
    import subprocess
    cmd = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", target,
           "vxstat --plain" if plain else "vxstat"]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=25)
        return (r.stdout or r.stderr or "").rstrip() or f"  {target}: no output"
    except subprocess.TimeoutExpired:
        return f"  {target}: TIMED OUT (box down, or ssh is prompting)"
    except OSError as exc:
        return f"  {target}: {exc}"


def main():
    args = sys.argv[1:]
    plain = "--plain" in args
    watch = "--watch" in args
    peers = [args[i + 1] for i, a in enumerate(args) if a == "--peer" and i + 1 < len(args)]
    every = 5.0
    if watch:
        i = args.index("--watch")
        if i + 1 < len(args):
            try:
                every = float(args[i + 1])
            except ValueError:
                pass
    s = Style(not plain and sys.stdout.isatty())

    def panel():
        parts = [render(s)]
        for t in peers:
            parts.append("")
            parts.append(peer_panel(t, plain))
        return "\n".join(parts)

    if not watch:
        print(panel())
        return
    try:
        while True:
            # Home the cursor and clear forward rather than clearing the whole screen, so the panel does not
            # flash on every refresh.
            sys.stdout.write("\033[H\033[J" + panel() + "\n" + s.dim(f"  refreshing every {every:.0f}s - Ctrl-C to exit") + "\n")
            sys.stdout.flush()
            time.sleep(every)
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
