+HashMap<ENetHost *, ENetConnection *> ENetConnection::oob_hosts;
+
+int ENetConnection::_oob_intercept(ENetHost *p_host, ENetEvent *p_event) {
+	// Return 0 for anything we do not claim, so ENet handles it exactly as before.
+	if (p_host->receivedDataLength < 4) {
+		return 0;
+	}
+	const uint8_t *d = p_host->receivedData;
+	if (d[0] != 0xFF || d[1] != 0xFF || d[2] != 0xFF || d[3] != 0xFF) {
+		return 0;
+	}
+
+	ENetConnection **found = oob_hosts.getptr(p_host);
+	if (!found || (*found)->oob_handler.is_null()) {
+		// Claimed by shape but nobody is listening. Consume it: ENet would only reject it anyway, and
+		// letting it through costs a protocol-error path per stray packet.
+		return 1;
+	}
+
+	IPAddress ip;
+#ifdef GODOT_ENET
+	ip.set_ipv6(p_host->receivedAddress.host);
+#else
+	ip = IPAddress(p_host->receivedAddress.host);
+#endif
+
+	PackedByteArray data;
+	data.resize(p_host->receivedDataLength);
+	memcpy(data.ptrw(), p_host->receivedData, p_host->receivedDataLength);
+
+	// Synchronous, inside service(). The handler is expected to enqueue rather than work: this runs in
+	// ENet's receive loop and every connected peer's traffic is waiting behind it.
+	Array args;
+	args.push_back(data);
+	args.push_back(String(ip));
+	args.push_back((int)p_host->receivedAddress.port);
+	(*found)->oob_handler.callv(args);
+	return 1;
+}
+
+void ENetConnection::set_oob_handler(const Callable &p_handler) {
+	ERR_FAIL_NULL_MSG(host, "The ENetConnection instance isn't currently active.");
+	oob_handler = p_handler;
+	if (p_handler.is_null()) {
+		oob_hosts.erase(host);
+		host->intercept = nullptr;
+	} else {
+		oob_hosts[host] = this;
+		host->intercept = &ENetConnection::_oob_intercept;
+	}
+}
