#!/usr/bin/env python3
"""Live status of Vortex Arena neural-bot training, across machines.

    vxstat                          this machine, one snapshot
    vxstat --peer user@host         also poll that machine, repeatable
    vxstat --watch                  refresh every second until Ctrl-C
    vxstat --watch 5                refresh every 5 seconds
    vxstat --json                   machine state as JSON (what peers are asked for)
    vxstat --plain                  no colour, for piping

Jobs are shown as a table: one row for the machine running the trainer, then a row for each machine feeding
it hosts, so a run spread over several boxes reads as one thing.

Local state is derived fresh from /proc (or a PowerShell snapshot on Windows) and the run's train.log on
every frame. PEER state is polled on a background thread every few seconds and cached, because an ssh round
trip is 1-2 seconds and fetching inline would cap the whole panel at the speed of the slowest machine. Each
peer row carries its age when stale, so an out-of-date number is visibly out of date rather than quietly
wrong.

Stage timings come from checkpoint mtimes, since the trainer does not timestamp its output: stage N started
when stage N-1's -done.pt was written.
"""
import os
import re
import sys
import time
from datetime import datetime

try:
    from zoneinfo import ZoneInfo
    # The box runs UTC; the person reading this does not. Convert here rather than making them do it.
    EASTERN = ZoneInfo("America/New_York")
except Exception:
    EASTERN = None

# Overridable so this is not welded to one box; the default is the training VM's layout.
RUNS = os.environ.get("VX_RUNS", "/home/vortex/train/runs")

# Which box this is. Shown in the header and prefixed to peer output, because once work is spread over
# machines an unlabelled panel cannot be read -- "64 hosts" means nothing without knowing whose.
try:
    MACHINE = os.uname().nodename
except AttributeError:
    MACHINE = os.environ.get("COMPUTERNAME", "?")
CORES = os.cpu_count() or 1


# ---------------------------------------------------------------- process table

WINDOWS = os.name == "nt"

# One PowerShell round trip per render, reused by processes/meminfo/loadavg/uptime.
#
# The Linux path reads /proc, which does not exist on Windows -- and once a worker machine runs Windows, a
# status tool that only works on Linux tells you nothing about half the fleet. Snapshotting once and sharing
# it keeps this to a single subprocess per refresh instead of four.
_WIN_SNAP = {"t": 0.0, "data": None}


def _windows_snapshot():
    import json
    import subprocess
    now = time.time()
    if _WIN_SNAP["data"] is not None and now - _WIN_SNAP["t"] < 1.0:
        return _WIN_SNAP["data"]
    ps = (
        "$p = Get-CimInstance Win32_Process | Select-Object ProcessId,CommandLine,WorkingSetSize,CreationDate;"
        "$o = Get-CimInstance Win32_OperatingSystem;"
        "$c = (Get-CimInstance Win32_Processor | Measure-Object -Property LoadPercentage -Average).Average;"
        "[pscustomobject]@{procs=$p; freeKB=$o.FreePhysicalMemory; totalKB=$o.TotalVisibleMemorySize;"
        " cpu=$c; now=(Get-Date)} | ConvertTo-Json -Depth 4 -Compress"
    )
    data = {"procs": [], "freeKB": 0, "totalKB": 0, "cpu": 0, "now": None}
    try:
        r = subprocess.run(["powershell", "-NoProfile", "-NonInteractive", "-Command", ps],
                           capture_output=True, text=True, timeout=25)
        if r.stdout.strip():
            data = json.loads(r.stdout)
    except Exception:
        pass
    _WIN_SNAP.update(t=now, data=data)
    return data


def _win_epoch(v):
    """Win32 CIM dates arrive as /Date(ms)/ through ConvertTo-Json, or as an ISO string."""
    if not v:
        return None
    if isinstance(v, str):
        m = re.search(r"/Date\((\d+)", v)
        if m:
            return int(m.group(1)) / 1000.0
        try:
            return datetime.fromisoformat(v.replace("Z", "+00:00")).timestamp()
        except ValueError:
            return None
    return None


def processes():
    """(pid, cmdline, rss_kb) for every readable process, self excluded.

    Read straight out of /proc rather than shelling to pgrep: a pgrep pattern matches the command line of
    whatever is doing the asking, which has bitten this project repeatedly -- including once where it killed
    the shell that issued it.
    """
    me = os.getpid()
    if WINDOWS:
        snap = _windows_snapshot()
        rows = snap.get("procs") or []
        if isinstance(rows, dict):
            rows = [rows]
        for row in rows:
            pid = row.get("ProcessId") or 0
            cmd = row.get("CommandLine") or ""
            if not cmd or pid == me:
                continue
            yield pid, cmd, int((row.get("WorkingSetSize") or 0) / 1024)
        return
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        pid = int(entry)
        if pid == me:
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as fh:
                cmd = fh.read().decode("utf-8", "replace").replace("\0", " ").strip()
            if not cmd:
                continue
            rss = 0
            with open(f"/proc/{pid}/statm") as fh:
                rss = int(fh.read().split()[1]) * (os.sysconf("SC_PAGE_SIZE") // 1024)
        except (OSError, ValueError, IndexError):
            continue
        yield pid, cmd, rss


def proc_age(pid):
    try:
        return time.time() - os.stat(f"/proc/{pid}").st_mtime
    except OSError:
        return 0.0


def uptime_of(pid):
    """Seconds since the process started, from its own start ticks against system uptime."""
    if WINDOWS:
        rows = _windows_snapshot().get("procs") or []
        if isinstance(rows, dict):
            rows = [rows]
        for row in rows:
            if row.get("ProcessId") == pid:
                started = _win_epoch(row.get("CreationDate"))
                return max(0.0, time.time() - started) if started else 0.0
        return 0.0
    try:
        with open(f"/proc/{pid}/stat") as fh:
            start_ticks = int(fh.read().rsplit(")", 1)[1].split()[19])
        with open("/proc/uptime") as fh:
            up = float(fh.read().split()[0])
        return max(0.0, up - start_ticks / os.sysconf("SC_CLK_TCK"))
    except (OSError, ValueError, IndexError):
        return 0.0


# ---------------------------------------------------------------- machine

def meminfo():
    if WINDOWS:
        snap = _windows_snapshot()
        total = (snap.get("totalKB") or 0) / 1048576.0
        avail = (snap.get("freeKB") or 0) / 1048576.0
        return total, total - avail, avail
    vals = {}
    try:
        with open("/proc/meminfo") as fh:
            for line in fh:
                k, _, v = line.partition(":")
                vals[k] = int(v.split()[0])
    except (OSError, ValueError):
        return 0.0, 0.0, 0.0
    total = vals.get("MemTotal", 0) / 1048576.0
    avail = vals.get("MemAvailable", 0) / 1048576.0
    return total, total - avail, avail


def loadavg():
    if WINDOWS:
        # Windows has no load average. CPU percent scaled to cores is the closest comparable number, and it
        # is labelled the same way in the panel so the two machines read alike.
        return (_windows_snapshot().get("cpu") or 0) / 100.0 * CORES
    try:
        with open("/proc/loadavg") as fh:
            return float(fh.read().split()[0])
    except (OSError, ValueError):
        return 0.0


# ---------------------------------------------------------------- log parsing

UPDATE = re.compile(
    r"\[s(?P<stage>\d) u\s*(?P<update>\d+)\]\s+steps\s+(?P<steps>[\d,]+)\s+(?P<sps>[\d.]+)/s"
    r".*?sampled\s+(?P<sampled>[\d.]+)%\s+shipped\s+(?P<shipped>[\d.]+)%"
    r".*?ent\s+(?P<ent>[-\d.]+)\s+kl\s+(?P<kl>[-\d.]+)")
EVAL = re.compile(r"\[s(?P<stage>\d)\].*?eval:\s+(?P<rate>[\d.]+)% arrivals \(gate (?P<gate>[\d.]+)%")
STAGE = re.compile(r"=== stage (?P<stage>\d): (?P<budget>[\d,]+) agent-steps, advance at (?P<gate>[\d.]+)%")

# Baselines re-measured on the FILTERED course pool, 3 seeds x 800 agent-episodes. Stages without a figure
# here were never re-measured after the filters landed, and their gates should not be trusted until they are.
BASELINE = {2: 28.9, 3: 38.5}


def tail(path, n=4000):
    try:
        with open(path, "rb") as fh:
            fh.seek(0, 2)
            size = fh.tell()
            fh.seek(max(0, size - n * 200))
            return fh.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return []


def run_config(run_dir):
    """The run's config.json, flattened across its nested sections.

    The file is {"args": {...}, "hyper": {...}, obs_size, action_logits}, so a top-level get finds nothing.
    Flattening one level keeps the lookup simple and survives a section being renamed or added.
    """
    try:
        import json
        with open(os.path.join(run_dir, "config.json")) as fh:
            raw = json.load(fh)
    except Exception:
        return {}
    flat = {}
    for k, v in raw.items():
        if isinstance(v, dict):
            flat.update(v)
        else:
            flat[k] = v
    return flat


def seconds_per_update(lines):
    """Wall seconds per update, derived from the log without needing timestamps.

    Each update line carries cumulative steps and a cumulative steps/s, so steps/sps is the elapsed time at
    that line. Differencing two lines gives the wall time between them. Taken over a window rather than a
    single pair, because one update straddling an eval is not representative of the rest.
    """
    seen = {}
    for line in lines:
        m = UPDATE.search(line)
        if m:
            try:
                sps = float(m["sps"])
                if sps > 0:
                    seen[int(m["update"])] = int(m["steps"].replace(",", "")) / sps
            except (ValueError, ZeroDivisionError):
                continue
    if len(seen) < 3:
        return None
    keys = sorted(seen)[-12:]
    du = keys[-1] - keys[0]
    dt = seen[keys[-1]] - seen[keys[0]]
    return dt / du if du > 0 and dt > 0 else None


def past_eval_seconds(lines):
    """Median wall time a completed eval took on this run, or None.

    Derived, not stored. Every update line carries cumulative steps and a cumulative steps/s, so steps/sps is
    the elapsed time at that line -- and the gap between consecutive updates is the wall time between them.
    Most gaps are one update; the ones that also contain an eval are several times longer. Subtracting the
    typical update from those long gaps leaves the eval.
    """
    elapsed = {}
    for line in lines:
        m = UPDATE.search(line)
        if m:
            try:
                sps = float(m["sps"])
                if sps > 0:
                    elapsed[int(m["update"])] = int(m["steps"].replace(",", "")) / sps
            except (ValueError, ZeroDivisionError):
                continue
    keys = sorted(elapsed)
    if len(keys) < 6:
        return None
    gaps = [(elapsed[b] - elapsed[a]) for a, b in zip(keys, keys[1:]) if b - a == 1]
    if len(gaps) < 5:
        return None
    ordered = sorted(gaps)
    spu = ordered[len(ordered) // 2]
    # Anything past three normal updates is an eval stall rather than a slow update.
    stalls = [g - spu for g in gaps if g > spu * 3.0]
    if not stalls:
        return None
    stalls.sort()
    return stalls[len(stalls) // 2]


def parse(lines):
    st = {"update": None, "evals": [], "stage": None, "budget": None, "gate": None,
          "skipped": 0, "diverge": 0, "starved": 0, "relaxed": 0}
    for line in lines:
        m = UPDATE.search(line)
        if m:
            st["update"] = m.groupdict()
        m = EVAL.search(line)
        if m:
            st["evals"].append((int(m["stage"]), float(m["rate"]), float(m["gate"])))
        m = STAGE.search(line)
        if m:
            st["stage"] = int(m["stage"])
            st["budget"] = int(m["budget"].replace(",", ""))
            st["gate"] = float(m["gate"])
        if "SKIPPED" in line:
            st["skipped"] += 1
        if "[diverge]" in line:
            st["diverge"] += 1
        if "no map in the pool" in line:
            st["starved"] += 1
        if "course draws relaxed" in line:
            st["relaxed"] += 1
    return st


# ---------------------------------------------------------------- formatting

def _enable_windows_ansi():
    """Turn on VT processing so ANSI escapes render instead of printing as literal gibberish.

    Windows Terminal does this already; the older console host does not, and the difference is invisible
    until the panel is full of escape codes. Harmless where it is already on.
    """
    if not WINDOWS:
        return
    try:
        import ctypes
        k = ctypes.windll.kernel32
        handle = k.GetStdHandle(-11)           # STD_OUTPUT_HANDLE
        mode = ctypes.c_uint32()
        if k.GetConsoleMode(handle, ctypes.byref(mode)):
            k.SetConsoleMode(handle, mode.value | 0x0004)   # ENABLE_VIRTUAL_TERMINAL_PROCESSING
    except Exception:
        pass


class Style:
    def __init__(self, on):
        self.on = on
        if on:
            _enable_windows_ansi()

    def __call__(self, s, code):
        return f"\033[{code}m{s}\033[0m" if self.on else s

    def dim(self, s):    return self(s, "2")
    def bold(self, s):   return self(s, "1")
    def green(self, s):  return self(s, "32")
    def yellow(self, s): return self(s, "33")
    def red(self, s):    return self(s, "31")
    def cyan(self, s):   return self(s, "36")


def dur(sec):
    sec = int(sec)
    if sec < 60:
        return f"{sec}s"
    if sec < 3600:
        return f"{sec // 60}m {sec % 60:02d}s"
    return f"{sec // 3600}h {(sec % 3600) // 60:02d}m"


def bar(frac, width, s):
    frac = max(0.0, min(1.0, frac))
    filled = int(round(frac * width))
    body = "#" * filled + "." * (width - filled)
    colour = s.green if frac >= 1.0 else (s.cyan if frac >= 0.75 else s.yellow)
    return colour(body)


def trend(vals):
    """Direction of the last few evals, stated only when there are enough to mean anything."""
    if len(vals) < 3:
        return "", ""
    recent, prior = vals[-3:], vals[-6:-3]
    if not prior:
        return "", ""
    delta = sum(recent) / len(recent) - sum(prior) / len(prior)
    if delta > 0.5:
        return "rising", "green"
    if delta < -0.5:
        return "falling", "red"
    return "flat", "yellow"


# ---------------------------------------------------------------- report

def snapshot():
    """This machine's state as plain data.

    Structured rather than pre-rendered, because a peer's numbers have to be laid out in the SAME table as
    the local ones. Shipping formatted text across the wire meant every machine drew its own panel and the
    reader had to correlate them by eye.
    """
    procs = list(processes())
    hosts = [(p, r) for p, c, r in procs if "va-neural-host.dll" in c]
    benches = [1 for _, c, _ in procs if "va-neural-host.dll" in c and "--bench" in c]
    total, used, free = meminfo()

    snap = {
        "machine": MACHINE,
        "cores": CORES,
        "hosts": len(hosts),
        "benches": sum(benches),
        "worst_host_mb": max((r for _, r in hosts), default=0) / 1024.0,
        "ram_used": used, "ram_total": total, "ram_free": free,
        "load": loadavg(),
        "runs": [],
    }

    # The EXECUTABLE must be python, not merely mentioned. A wrapper such as `nohup python train.py ...`
    # carries both words in its command line and would otherwise be counted as a second copy of the same run.
    trainers = []
    seen_names = set()
    for p, c, _ in procs:
        if "train.py" not in c or " -c " in c:
            continue
        head = c.split()[0].strip('"').lower() if c.split() else ""
        if "python" not in os.path.basename(head):
            continue
        name = (re.search(r"--name (\S+)", c) or [None, "?"])[1]
        if name in seen_names:
            continue
        seen_names.add(name)
        trainers.append((p, c))
        snap["runs"].append(run_snapshot(name, p, uptime_of(p), c, procs, True))

    if not trainers and snap["hosts"] == 0:
        # Nothing training AND nothing serving. A machine with hosts but no trainer is a worker for someone
        # else's job, and its last finished run is not what it is doing now -- showing it there implies work
        # that is not happening and counts its hosts twice, once here and once under the job they serve.
        try:
            logs = sorted(((os.path.getmtime(os.path.join(RUNS, d, "train.log")), d)
                           for d in os.listdir(RUNS)
                           if os.path.exists(os.path.join(RUNS, d, "train.log"))), reverse=True)
        except OSError:
            logs = []
        if logs:
            snap["runs"].append(run_snapshot(logs[0][1], None, 0, "", procs, False))
    return snap


def run_snapshot(name, pid, up, cmd, procs, running):
    run_dir = os.path.join(RUNS, name)
    lines = tail(os.path.join(run_dir, "train.log"))
    st = parse(lines)
    u = st["update"]
    stage = int(u["stage"]) if u else (st["stage"] or 0)
    rates = [r for sg, r, _ in st["evals"] if sg == stage]
    gate = st["gate"] or (st["evals"][-1][2] if st["evals"] else 0.0)
    cfg = run_config(run_dir)

    try:
        every = int(cfg.get("eval_every", 0))
    except (TypeError, ValueError):
        every = 0
    shards = [p for p, c, _ in procs if "va-neural-host.dll" in c and "--bench" in c and "--policy" in c]
    try:
        total_shards = int(cfg.get("eval_shards", 0)) or len(shards)
    except (TypeError, ValueError):
        total_shards = len(shards)

    steps = int(u["steps"].replace(",", "")) if u else 0
    spu = seconds_per_update(lines)
    eval_secs = past_eval_seconds(lines)

    # Which other machines are feeding this run. The trainer's own command line is the only place this is
    # recorded, and it is what lets a job be shown as one row per participating machine.
    remotes = []
    for spec in re.findall(r"--remote (\S+)", cmd or ""):
        parts = spec.split(":")
        if len(parts) >= 2:
            remotes.append({"addr": parts[0], "count": int(parts[2]) if len(parts) > 2 else 1})

    return {
        "name": name, "running": running, "up": up, "stage": stage,
        "best": max(rates) if rates else None,
        "last": rates[-6:],
        "gate": gate,
        "baseline": BASELINE.get(stage),
        "steps": steps, "budget": st["budget"] or 0,
        "sps": float(u["sps"]) if u else 0.0,
        "update": int(u["update"]) if u else 0,
        "entropy": float(u["ent"]) if u else 0.0,
        "kl": float(u["kl"]) if u else 0.0,
        "sampled": float(u["sampled"]) if u else 0.0,
        "skipped": st["skipped"], "diverge": st["diverge"],
        "starved": st["starved"], "relaxed": st["relaxed"],
        "eval_every": every, "eval_secs": eval_secs, "spu": spu,
        "eval_running": len(shards) > 0,
        "eval_done": max(0, total_shards - len(shards)) if shards else 0,
        "eval_total": total_shards,
        "eval_elapsed": max((uptime_of(p) for p in shards), default=0.0),
        "remotes": remotes,
        "local_hosts_flag": _int_arg(cmd, "--hosts"),
    }


def _int_arg(cmd, flag):
    m = re.search(re.escape(flag) + r" (\d+)", cmd or "")
    return int(m.group(1)) if m else None


# ---------------------------------------------------------------- peers

class Peers:
    """Background poller for other machines.

    Refreshed on its own slow cadence while the panel redraws fast. An ssh round trip is 1-2 seconds, so
    fetching inline would cap the refresh rate at the speed of the slowest machine -- the panel would stutter
    for a number that only changes every few seconds anyway. Each entry carries its age so a stale peer is
    visibly stale rather than quietly wrong.
    """

    def __init__(self, targets, period=5.0):
        self.targets = targets
        self.period = period
        self.data = {t: {"snap": None, "at": 0.0, "err": "connecting"} for t in targets}
        self._stop = False
        if targets:
            import threading
            self._thread = threading.Thread(target=self._loop, daemon=True)
            self._thread.start()

    def _fetch(self, target):
        import json
        import subprocess
        try:
            r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", target,
                                "vxstat --json"],
                               capture_output=True, text=True, timeout=20)
            if not r.stdout.strip():
                return None, (r.stderr.strip().splitlines() or ["no output"])[-1][:40]
            return json.loads(r.stdout), None
        except subprocess.TimeoutExpired:
            return None, "timeout"
        except Exception as exc:
            return None, type(exc).__name__

    def _loop(self):
        while not self._stop:
            for t in self.targets:
                snap, err = self._fetch(t)
                if snap is not None:
                    self.data[t] = {"snap": snap, "at": time.time(), "err": None}
                else:
                    self.data[t]["err"] = err
            time.sleep(self.period)

    def snapshots(self):
        out = []
        for t in self.targets:
            d = self.data[t]
            if d["snap"] is not None:
                s = dict(d["snap"])
                s["age"] = time.time() - d["at"]
                s["target"] = t
                out.append(s)
            else:
                out.append({"machine": t, "unreachable": d["err"], "runs": [], "hosts": 0,
                            "ram_used": 0, "ram_total": 0, "ram_free": 0, "load": 0, "cores": 0,
                            "target": t, "age": 0})
        return out


# ---------------------------------------------------------------- table

def health_cell(r, s):
    """One cell, not four lines. Silence is the healthy case."""
    bad = []
    if r["skipped"]:
        bad.append(f"skip{r['skipped']}")
    if r["diverge"]:
        bad.append("DIVERGE")
    if r["starved"]:
        bad.append("STARVE")
    if r["relaxed"]:
        bad.append("relax")
    return s.red(" ".join(bad)) if bad else s.green("ok")


def eval_cell(r, s):
    if r["eval_running"]:
        left = ""
        if r["eval_secs"] and r["eval_secs"] > r["eval_elapsed"]:
            left = f"-{dur(r['eval_secs'] - r['eval_elapsed'])}"
        return s.cyan(f"{r['eval_done']}/{r['eval_total']} {left}")
    if r["eval_every"] and r["update"]:
        togo = r["eval_every"] - (r["update"] % r["eval_every"])
        if not r["spu"]:
            return f"in {togo}u"
        secs = togo * r["spu"]
        eta = f"{secs / 60:.0f}m" if secs >= 60 else f"{secs:.0f}s"
        return f"in {togo}u {eta}"
    return "-"


def pad(text, width, s):
    """Pad to a visible width, ignoring escape codes, which str.ljust would count."""
    visible = re.sub(r"\033\[[0-9;]*m", "", text)
    return text + " " * max(0, width - len(visible))


COLS = [("JOB", 8), ("MACHINE", 14), ("ST", 3), ("BEST", 7), ("GATE", 6), ("PROGRESS", 20),
        ("STEP/S", 8), ("HOSTS", 6), ("RAM", 12), ("CPU", 5), ("EVAL", 15), ("HEALTH", 8)]


def render_table(local, peers, s):
    out = []
    now = (datetime.now(EASTERN).strftime("%I:%M:%S %p ET").lstrip("0")
           if EASTERN else datetime.now().strftime("%I:%M:%S %p local").lstrip("0"))
    header = "".join(pad(s.dim(h), w, s) for h, w in COLS)
    out.append(s.bold("VORTEX NEURAL TRAINING") + s.dim(f"    {now}"))
    out.append("")
    out.append("  " + header)

    by_machine = {p["machine"]: p for p in peers}
    all_snaps = [local] + peers

    # One block per job: the trainer's machine, then every machine feeding it hosts.
    shown_machines = set()
    for snap in all_snaps:
        for r in snap.get("runs", []):
            out.append("  " + job_row(r, snap, s, trainer=True))
            shown_machines.add(snap["machine"])
            for rem in r.get("remotes", []):
                peer = _match_peer(rem["addr"], peers)
                if peer is not None:
                    out.append("  " + worker_row(peer, rem, s))
                    shown_machines.add(peer["machine"])
                else:
                    out.append("  " + pad("", 8, s) + pad(s.dim(rem["addr"]), 14, s)
                               + s.dim(f"{rem['count']} hosts, machine not polled (add --peer)"))

    # Machines with no job of their own and not claimed by one above.
    for snap in all_snaps:
        if snap["machine"] in shown_machines:
            continue
        out.append("  " + idle_row(snap, s))

    return "\n".join(out)


def _match_peer(addr, peers):
    for p in peers:
        if p.get("unreachable"):
            continue
        if addr in (p.get("target", ""), p.get("machine", "")) or p.get("target", "").endswith("@" + addr):
            return p
    return None


def job_row(r, snap, s, trainer):
    pct = r["steps"] / r["budget"] if r["budget"] else 0
    best = f"{r['best']:.1f}%" if r["best"] is not None else "-"
    gate = f"{r['gate']:.0f}%" if r["gate"] else "-"
    name = r["name"] + ("" if r["running"] else "*")
    cells = [
        s.cyan(name) if r["running"] else s.red(name),
        s.bold(snap["machine"]),
        str(r["stage"]),
        s.bold(best),
        gate,
        f"{pct * 100:3.0f}% {bar(pct, 12, s)}",
        f"{r['sps']:,.0f}",
        str(snap["hosts"]),
        ram_cell(snap, s),
        cpu_cell(snap, s),
        eval_cell(r, s),
        health_cell(r, s),
    ]
    return "".join(pad(c, w, s) for c, (_, w) in zip(cells, COLS))


def worker_row(peer, rem, s):
    age = f" {peer['age']:.0f}s ago" if peer.get("age", 0) > 12 else ""
    cells = ["", s.dim("+ " + peer["machine"]) + s.dim(age), "", "", "", s.dim("  worker"),
             "", str(rem["count"]), ram_cell(peer, s), cpu_cell(peer, s), "", ""]
    return "".join(pad(c, w, s) for c, (_, w) in zip(cells, COLS))


def idle_row(snap, s):
    if snap.get("unreachable"):
        cells = [s.red("-"), s.red(snap["machine"]), "", "", "",
                 s.red(f"unreachable: {snap['unreachable']}"), "", "", "", "", "", ""]
    else:
        cells = [s.dim("idle"), snap["machine"], "", "", "", s.dim("  no run"), "",
                 str(snap["hosts"]), ram_cell(snap, s), cpu_cell(snap, s), "", ""]
    return "".join(pad(c, w, s) for c, (_, w) in zip(cells, COLS))


def ram_cell(snap, s):
    if not snap.get("ram_total"):
        return "-"
    txt = f"{snap['ram_used']:.0f}/{snap['ram_total']:.0f} GB"
    if snap["ram_free"] < 2.0:
        return s.red(txt)
    if snap["ram_free"] < 4.0:
        return s.yellow(txt)
    return txt


def cpu_cell(snap, s):
    if not snap.get("cores"):
        return "-"
    frac = snap["load"] / snap["cores"]
    txt = f"{frac * 100:.0f}%"
    return s.green(txt) if frac > 0.85 else (txt if frac > 0.4 else s.yellow(txt))


def detail_lines(local, peers, s):
    """The few things a table cannot carry, for the run that is actually training here."""
    out = []
    for snap in [local] + peers:
        for r in snap.get("runs", []):
            if not r["running"]:
                continue
            base = f"  vs baseline {r['best'] / r['baseline']:.2f}x" if (r["baseline"] and r["best"]) else ""
            last = "  ".join(f"{x:.1f}" for x in r["last"])
            out.append("")
            out.append(s.dim(f"  {r['name']} on {snap['machine']}: last evals  {last}{base}"))
            out.append(s.dim(f"  entropy {r['entropy']:.3f}   kl {r['kl']:.4f}   "
                             f"sampled {r['sampled']:.1f}%   up {dur(r['up'])}   update #{r['update']:,}"))
    return out


def main():
    args = sys.argv[1:]
    plain = "--plain" in args
    watch = "--watch" in args
    as_json = "--json" in args
    peers_t = [args[i + 1] for i, a in enumerate(args) if a == "--peer" and i + 1 < len(args)]

    every = 1.0
    if watch:
        i = args.index("--watch")
        if i + 1 < len(args):
            try:
                every = max(0.25, float(args[i + 1]))
            except ValueError:
                pass

    if as_json:
        import json
        print(json.dumps(snapshot()))
        return

    s = Style(not plain and (sys.stdout.isatty() or "--color" in args))
    poller = Peers(peers_t)

    def panel():
        local = snapshot()
        remote = poller.snapshots()
        body = render_table(local, remote, s)
        return body + "\n" + "\n".join(detail_lines(local, remote, s))

    if not watch:
        # A one-shot call has to wait for the first peer fetch; there is nothing cached yet.
        if peers_t:
            time.sleep(2.5)
        print(panel())
        return
    try:
        while True:
            sys.stdout.write("\033[H\033[J" + panel() + "\n"
                             + s.dim(f"  refreshing every {every:.0f}s - Ctrl-C to exit") + "\n")
            sys.stdout.flush()
            time.sleep(every)
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
