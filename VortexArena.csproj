<Project Sdk="Godot.NET.Sdk/4.6.3">
  <!-- The Godot host: the game client + (headless) dedicated server entry point.
       This is the ONE Godot-managed C# project; everything else is a referenced class library.
       SDK version matches the installed Godot 4.6.3 .NET editor; the stable 4.6.3 SDK package isn't on
       public NuGet, so nuget.config adds the editor's bundled package source. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>VortexArena</RootNamespace>
    <!-- C1: pin the GC flavor explicitly so it isn't default-dependent (planning/PERFORMANCE_REPORT.md C1).
         Workstation (ServerGarbageCollection=false) + concurrent — short, non-blocking, background collections,
         the right trade for the interactive client's render loop. Both values ARE the .NET default for a client
         app, so pinning them changes nothing today; it documents intent and guards a future default shift. Do
         NOT flip ServerGarbageCollection true without profiling — it trades client frame-pauses for dedicated
         throughput (see planning/PERFORMANCE_REPORT.md §7). LatencyMode (SustainedLowLatency) is set at boot in Main.cs. -->
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- C3 Tier-1: the StringApiAnalyzer (XG0001) bans the never-used string-keyed Godot APIs that mint a
         per-call marshaling allocation (godot#105750). Elevated to an ERROR here so a regression fails the host
         build (zero current matches in game/, so zero false positives). Suppressible per-line with
         #pragma warning disable XG0001. XG0002 (Tier-2) is reserved for the _Process-scope rule. -->
    <WarningsAsErrors>$(WarningsAsErrors);XG0001</WarningsAsErrors>
  </PropertyGroup>
  <!-- A5: pre-compile game-code IL to native at EXPORT time (ReadyToRun) so a novel call path doesn't pay a
       tier-0 JIT hitch the first time it runs mid-game. Gated to the release-export configuration (Godot's
       ExportRelease, a RID-targeted `dotnet publish` — R2R needs a RID), so the editor/Debug build and the
       tests are unaffected. Tiered compilation stays ON: R2R images are tier-0 quality and tiering re-JITs hot
       methods to tier-1 in the background, so DON'T disable it globally (planning/PERFORMANCE_REPORT.md A5/A1.4). -->
  <PropertyGroup Condition="'$(Configuration)' == 'ExportRelease'">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <!-- ...with ONE documented exception. ReadyToRun compiles IL to native at publish time, which needs a
       crossgen2 pack FOR THE TARGET RID, and Microsoft publishes none for linux-ppc64le: as of 2026-08-19
       nuget.org 404s both Microsoft.NETCore.App.Crossgen2.linux-ppc64le and the matching
       Microsoft.NETCore.App.Runtime.linux-ppc64le, while the linux-x64 pair resolve normally - so the
       package IDs are right and the packages genuinely are not there (.NET on POWER is delivered by
       Red Hat/IBM as distro packages, not through the public feed). Left on, a ppc64le export fails at
       restore with NU1101, which names the package and not the cause. What turning it off costs is what
       R2R buys - a first-call JIT hitch on a code path that has not run yet - a frame-time concern on a
       client and close to irrelevant on the dedicated server POWER hardware would realistically run.
       Revisit if a crossgen2 pack for this RID ever ships. See planning/ppc64le-port-2026-08-19.md. -->
  <PropertyGroup Condition="$(RuntimeIdentifier.EndsWith('-ppc64le'))">
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
  <!-- Godot.NET.Sdk globs **/*.cs from the project root, which would double-compile the class
       libraries under src/ (and their obj/). The host compiles only its own code (root + game/). -->
  <ItemGroup>
    <Compile Remove="src/**/*.cs" />
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="planning/**/*.cs" />
    <!-- The ./vx task runner (tools/vx/) is a standalone console app with its own csproj. Godot.NET.Sdk
         globs **/*.cs from the project directory, so without this its Program.cs would be compiled INTO the
         game host — a second Main, and tooling code shipped in the game assembly. -->
    <Compile Remove="tools/**/*.cs" />
    <Compile Remove=".godot/**/*.cs" />
    <Compile Remove="obj/**/*.cs" />
    <Compile Remove="bin/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="src\VortexArena.Common\VortexArena.Common.csproj" />
    <ProjectReference Include="src\VortexArena.Engine\VortexArena.Engine.csproj" />
    <ProjectReference Include="src\VortexArena.Net\VortexArena.Net.csproj" />
    <ProjectReference Include="src\VortexArena.Formats\VortexArena.Formats.csproj" />
    <ProjectReference Include="src\VortexArena.Server\VortexArena.Server.csproj" />
  </ItemGroup>
  <!-- C3: run the StringApiAnalyzer over game/ (where all the Godot interop lives). The analyzer is also an
       Analyzer reference from VortexArena.Common; analyzers don't flow transitively through ProjectReference,
       so the host needs its own. ReferenceOutputAssembly=false — we consume only its analyzers, not its API. -->
  <ItemGroup>
    <ProjectReference Include="src\VortexArena.SourceGen\VortexArena.SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
