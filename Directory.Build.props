<Project>
  <!-- Shared MSBuild properties for all VortexArena projects.
       The Godot host (Godot.NET.Sdk) and the SourceGen analyzer (netstandard2.0)
       set their own TargetFramework; the plain libraries inherit $(VortexArenaTfm). -->
  <PropertyGroup>
    <VortexArenaTfm>net8.0</VortexArenaTfm>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- (2026-08-03) THE MACHINE'S LOCALE MUST NOT REACH THE NUMBERS.
         A contributor on a Russian-locale box hit this as a test failure — DeferredCommands printed
         "-> In      1,50: restart", because plain interpolation formats with CurrentCulture and ru-RU uses a
         comma. Cosmetic there, not cosmetic in general: this is a Quake/DarkPlaces port whose cvar values
         round-trip through config.cfg, the console and rcon, so a locale that WRITES "1,50" produces a config
         that will not parse back, and console output that disagrees with DP. DP itself is immune — C's %f in
         the default "C" locale is period-always.
         Measured before choosing this over a site-by-site sweep: ~78 un-invariant float.Parse calls (against
         88 that already pass InvariantCulture — the tree was half-fixed), ~82 interpolations with a numeric
         format, ~31 ToString("F.."). One property fixes all of them and, unlike a sweep, cannot regress.
         The wider blast radius was checked rather than assumed, and is empty: no `new CultureInfo` anywhere,
         no StringComparison.CurrentCulture, and all 113 ToUpper/ToLower calls are already the Invariant
         overloads. So this makes the runtime agree with what the code already believed.
         Consequence to know: creating a specific culture (new CultureInfo("ru-RU")) now throws. If real UI
         localisation ever lands it belongs in string tables, not in CultureInfo — but if that changes, this
         is the line to revisit. LocaleInvarianceTests pins the behaviour. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- (perf 2026-07-03) Debug builds run JIT-OPTIMIZED by default: the editor/dev builds are what gets
       playtested daily, and unoptimized IL is a 2-5x tax on exactly the hot loops (world traces, the 72Hz
       sim, bot tracewalks, per-frame entity drive) that drive frame hitches — a debug session on stormkeep
       spends most of its hitch budget there. DEBUG defines/asserts and portable PDBs are untouched, so
       stack traces, Prof scopes and #if DEBUG diagnostics all keep working; what you lose is step-debugging
       fidelity (inlined frames, optimized-away locals). For a breakpoint session, restore classic Debug
       codegen with:  dotnet build -p:VaDebugUnoptimized=true  (the FrameProfiler env banner reports which
       flavor a session ran: csharp=Debug(jit-opt) vs Debug(unopt)). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(VaDebugUnoptimized)' != 'true'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- (2026-07-27) BOT-PLAYER HARNESS - compile-time opt-in, never in a normal build.

       Drives the LOCAL HUMAN player slot from a bot brain, so an unattended run exercises the real player
       code path (client input sampling, prediction, input encode, net, server authority, snapshot,
       reconcile) instead of only the spectate-a-bot path, which never touches any of it.

       This is deliberately NOT a cvar. A brain steering a human player IS an aimbot: the code must not exist
       in anything shippable, so the gate is the compiler, not a runtime flag a config could set. Nothing is
       compiled in unless you ask for it here, and even then it stays dormant until the CLI flag is passed.
       Build it with:  dotnet build VortexArena.csproj -c Debug -p:VaBotPlayer=true
       Run it with the "bot-player" CLI flag (see BotPlayerMode / docs/RUNNING.md).

       Keep every use of it inside #if VA_BOTPLAYER. Never define this for a release/export build. -->
  <PropertyGroup Condition="'$(VaBotPlayer)' == 'true'">
    <DefineConstants>$(DefineConstants);VA_BOTPLAYER</DefineConstants>
  </PropertyGroup>
</Project>
