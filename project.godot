; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="VortexArena"
config/description="Vortex Arena — Xonotic, reborn on Godot + C#. See planning/."
run/main_scene="res://Main.tscn"
; r16 rubberband ROOT CAUSE: Godot's delta smoothing (default ON) snaps every _Process delta onto a grid
; derived from the DETECTED refresh rate — which this platform misreads as 60Hz on high-refresh panels
; (the known borderless under-report; see ClientSettings' auto-cap note). On a 143Hz display the sim was
; fed 8.33/11.11/16.67ms quantized deltas while real frames ran otherwise — everything moved measurably
; slow-then-fast (the motion trace caught 11.11ms-constant deltas over 8.33ms wall frames = 33% slow).
; Raw measured deltas are DP-faithful (cl.realframetime) and what every timing system here expects.
run/delta_smooth=false
config/features=PackedStringArray("4.6", "C#", "Forward Plus")

[dotnet]

project/assembly_name="VortexArena"

[physics]

; (perf 2.0 / R30, 2026-07-06) The game runs its OWN 72 Hz sim + collision (TraceService/CollisionWorld);
; Godot's physics serves NOTHING today: zero body/area/query users (BuildCollisionMesh is caller-less, the
; casings/gibs _PhysicsProcess nodes never spawn - see planning/perf-campaign-2026-07-06.md Phase 1c: the
; 60 Hz phase cost 0.15-0.39 ms/frame for nothing, and catch-up steps amplified hitches). 10 Hz keeps the
; phase alive for future opt-ins (ragdolls) at ~zero cost. If a real Godot-physics consumer ever lands,
; raise these deliberately. (Godot strips these comments on re-serialise - rationale lives in the campaign
; doc.)
;
; (2026-07-26 WOBBLE ROOT CAUSE - planning/wobble-independent-audit-2026-07-26.md 3f) These settings do not
; only cost nothing, they used to REWRITE THE FRAME DELTA. MainTimerSync::advance_checked clamps process_step
; into [min_avg_physics_steps, max_avg_physics_steps] * physics_step and then to +-physics_jitter_fix *
; physics_step, carrying the difference in a time_deficit ledger repaid on later frames. NONE of that is
; gated by run/delta_smooth below (that only disables DeltaSmoother, which also needs VSYNC_ENABLED and so
; never ran at our vid_vsync 0 default). At physics_step = 0.1 s the band at ~144 fps is [0, 100/12 ms] =
; [0, 8.333 ms]: the ceiling sits ~1.4 ms above the median frame time and the floor collapses to 0, making
; it a one-sided rectifier. Measured: 23-40% of frames reported a time on the 100/N ms grid, the ledger rode
; its +-50 ms rails, and embodied-vs-elapsed time diverged -20%/+28% (p1/p99) over 300 ms windows.
;   physics_jitter_fix 0 -> clamp 2 degenerates to clamp(measured, measured), so _Process receives the delta
;   Godot actually measured (DP cl.realframetime). Nothing to protect: Godot physics has no consumers here.
;   Live A/B without a re-export: cl_engine_jitterfix (ClientSettings.ApplyEngineTiming) re-applies this at
;   runtime; 0.5 restores Godot stock. Score legs with tools/wobble-detect.py.
;   max_physics_steps_per_frame back to 8: main.cpp:4857 subtracts (steps - max) * physics_step from the
;   REPORTED delta for every dropped step, which at 0.1 s/step drove _Process deltas negative after a
;   >=200 ms hitch (the 0.875 ms = p_process_step/8 floor crushes and the skipped trace rows). 8 empty 10 Hz
;   steps cover an 800 ms stall and still cost nothing, since nothing runs in _PhysicsProcess.
common/physics_ticks_per_second=10
common/max_physics_steps_per_frame=8
common/physics_jitter_fix=0.0

[rendering]

; (r16 ran a minimal-swapchain EXPERIMENT here — frame_queue_size=1 / swapchain_image_count=2, the
; queue-elasticity candidate. Feel-inconclusive, and a 1-deep queue couples CPU frame time directly to any
; GPU cost ripple, confounding the variance-elimination measurements — reverted to engine defaults
; 2026-07-11. History: commit 391396f + planning/frametime-parity-audit-2026-07-11.md.)

textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=2
; (engine-perf 2026-06-16) Dither the final image to kill banding in the sky / large gradients. A pipeline-key
; change set once at boot (never toggled mid-match) so it costs nothing at runtime — ~0 CPU, sub-ms GPU, and
; we're GPU-idle. The warm SubViewport copies UseDebanding from the live viewport, so warmed variants match.
; (NOTE: Godot strips these comments whenever it re-serialises project.godot — e.g. on export. Rationale also
; lives in planning/engine-optimization-2026-06-15.md. The Vulkan RD driver is already the verified default —
; "Vulkan 1.4.341 - Forward+" — so no rendering_device/driver.windows pin is needed; Godot drops it as redundant.)
anti_aliasing/quality/use_debanding=true
; Allocates the software occlusion-culling buffer so OccluderInstance3D works. Per-viewport opt-in still
; gates it: only the game viewport turns it on (via the r_occlusion_cull cvar / WorldOcclusion); the menu
; viewport leaves Viewport.use_occlusion_culling=false, so this is ~free until a map enables the A/B path.
occlusion_culling/use_occlusion_culling=true
; Required for the macOS universal/arm64 export (the Apple-Silicon slice uses ETC2/ASTC, not S3TC/BPTC).
; Harmless for the Windows/Linux exports — their presets don't include the etc2_astc texture variants.
textures/vram_compression/import_etc2_astc=true
